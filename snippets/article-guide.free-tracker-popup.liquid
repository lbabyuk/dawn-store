{% comment %}
  Free Tracker two-step modal:
  1) form (email + CTA)
  2) success (download)

  Accepts:
  - ft_uid, ft_image, ft_image_alt, ft_sticker_image
  - ft_heading, ft_description, ft_placeholder, ft_button, ft_disclaimer
  - ft_success_heading, ft_download_label, ft_success_note, ft_pdf
{% endcomment %}

<div class="free-tracker__modal" data-ft-modal hidden>
  <div class="free-tracker__modal-backdrop" data-ft-close tabindex="-1"></div>
  <div
    class="free-tracker__modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="{{ ft_uid }}-form-heading"
    data-ft-dialog
  >
    <button type="button" class="free-tracker__modal-close" data-ft-close aria-label="Close">
      <svg width="17" height="23" viewBox="0 0 17 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M16.3086 19.5703L13.125 22.4023C11.0938 20.0716 9.31641 17.8451 7.79297 15.7227L3.78906 22.4805L0.195312 20.332L5.19531 11.8555C4.71354 11.0742 4.24479 10.2995 3.78906 9.53125C3.34635 8.75 2.95573 8.04688 2.61719 7.42188C2.29167 6.78385 1.98568 6.17839 1.69922 5.60547C1.41276 5.03255 1.16536 4.52474 0.957031 4.08203C0.761719 3.63932 0.592448 3.26172 0.449219 2.94922C0.31901 2.63672 0.214844 2.38281 0.136719 2.1875C0.0585938 1.97917 0.0130208 1.86849 0 1.85547L3.96484 0.371094L4.12109 0.722656C4.21224 0.957031 4.35547 1.29557 4.55078 1.73828C4.74609 2.18099 4.97396 2.6888 5.23438 3.26172C5.50781 3.82161 5.85286 4.4987 6.26953 5.29297C6.69922 6.08724 7.15495 6.88802 7.63672 7.69531L12.1875 0L15.8398 2.16797L10.1953 11.6797C12.0182 14.4401 14.056 17.0703 16.3086 19.5703Z" fill="#7E3253"/>
      </svg>
    </button>

    <div class="free-tracker__modal-media">
      {%- if ft_image != blank -%}
        {{
          ft_image
          | image_url: width: 720
          | image_tag:
            class: 'free-tracker__modal-image',
            loading: 'lazy',
            widths: '220, 320, 420, 560, 720',
            sizes: '(min-width: 768px) 320px, 60vw',
            alt: ft_image_alt
        }}
      {%- endif -%}
      {%- if ft_sticker_image != blank -%}
        <div class="free-tracker__sticker free-tracker__sticker--modal" aria-hidden="true">
          {{
            ft_sticker_image
            | image_url: width: 214
            | image_tag:
              class: 'free-tracker__sticker-img',
              loading: 'lazy',
              widths: '107, 160, 214',
              sizes: '107px',
              alt: ft_sticker_image.alt
          }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Step 1: form {%- endcomment -%}
    <div class="free-tracker__step" data-ft-step="form">
      {%- if ft_heading != blank -%}
        <h2 id="{{ ft_uid }}-form-heading" class="free-tracker__heading free-tracker__heading--modal _richtext-md text-32-alt">
          {{ ft_heading | escape }}
        </h2>
      {%- endif -%}

      {%- if ft_description != blank -%}
        <div class="free-tracker__description free-tracker__description--modal rte _richtext-md text-14/12">
          {{ ft_description }}
        </div>
      {%- endif -%}

      <form class="free-tracker__form" data-ft-form data-ft-modal-form novalidate>
        <label class="sr-only" for="{{ ft_uid }}-modal-email">
          {{ ft_placeholder | default: 'Email' | escape }}
        </label>
        <input
          id="{{ ft_uid }}-modal-email"
          class="free-tracker__input"
          type="email"
          name="email"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          inputmode="email"
          placeholder="{{ ft_placeholder | escape }}"
          required
          aria-describedby="{{ ft_uid }}-modal-email-error"
          data-ft-email
        >
        <button type="submit" class="free-tracker__button text-20-bold" data-ft-submit>
          <span data-ft-submit-label>{{ ft_button | escape }}</span>
        </button>
      </form>

      <p id="{{ ft_uid }}-modal-email-error" class="free-tracker__message" data-ft-message hidden role="alert"></p>

      {%- if ft_disclaimer != blank -%}
        <p class="free-tracker__disclaimer">
          <span class="free-tracker__disclaimer-icon" aria-hidden="true"></span>
          <span>{{ ft_disclaimer | escape }}</span>
        </p>
      {%- endif -%}
    </div>

    {%- comment -%} Step 2: success {%- endcomment -%}
    <div class="free-tracker__step" data-ft-step="success" hidden>
      {%- if ft_success_heading != blank -%}
        <h2 id="{{ ft_uid }}-success-heading" class="free-tracker__heading free-tracker__heading--modal _richtext-md text-32-alt">
          {{ ft_success_heading | escape }}
        </h2>
      {%- endif -%}

      <p class="free-tracker__description free-tracker__description--modal _richtext-md text-14/12" data-ft-success-copy></p>

      {%- if ft_pdf != blank -%}
        <a
          class="free-tracker__button free-tracker__button--download text-20-bold"
          href="{{ ft_pdf }}"
          download
          target="_blank"
          rel="noopener"
          data-ft-download
        >
          {{ ft_download_label | escape }}
        </a>
      {%- else -%}
        <button type="button" class="free-tracker__button free-tracker__button--download text-20-bold" data-ft-download disabled>
          {{ ft_download_label | escape }}
        </button>
      {%- endif -%}

      {%- if ft_success_note != blank -%}
        <p class="free-tracker__success-note">
          <span class="free-tracker__success-note-icon" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5.48438 3.49219V2.48438H4.5V3.49219H5.48438ZM5.48438 7.5V4.5H4.5V7.5H5.48438ZM1.45312 1.47656C2.4375 0.492188 3.61719 0 4.99219 0C6.36719 0 7.53906 0.492188 8.50781 1.47656C9.49219 2.44531 9.98438 3.61719 9.98438 4.99219C9.98438 6.36719 9.49219 7.54688 8.50781 8.53125C7.53906 9.5 6.36719 9.98438 4.99219 9.98438C3.61719 9.98438 2.4375 9.5 1.45312 8.53125C0.484375 7.54688 0 6.36719 0 4.99219C0 3.61719 0.484375 2.44531 1.45312 1.47656Z" fill="currentColor"/>
            </svg>
          </span>
          <span>{{ ft_success_note | escape }}</span>
        </p>
      {%- endif -%}
    </div>
  </div>
</div>
