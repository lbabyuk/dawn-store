{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}
{{ 'section-article-guide.css' | asset_url | stylesheet_tag }}
{{ 'section-guide-tabs.css' | asset_url | stylesheet_tag }}
{{ 'section-guide-ladder.css' | asset_url | stylesheet_tag }}
{{ 'section-guide-before-start.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-guide-callout-accordion.js' | asset_url }}" defer></script>
<script src="{{ 'guide-tabs.js' | asset_url }}" defer></script>

{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal | default: 36
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile | default: 16
  assign callout_radius = section.settings.callout_radius | default: 12
  assign callout_text_size = section.settings.callout_text_size | default: 16
  assign callout_text_size_mobile = section.settings.callout_text_size_mobile | default: 16
  assign color_callout_bg = section.settings.color_callout_bg | default: '#FFE0E0'
  assign color_callout_text = section.settings.color_callout_text | default: '#2A2E15'
  assign color_link = section.settings.color_link | default: '#1A1A1A'
  assign color_bg = section.settings.color_background | default: '#FFFFFF'
  assign color_heading = section.settings.color_heading | default: '#1A1A1A'
  assign color_text = section.settings.color_text | default: '#333333'
  assign color_text_muted = section.settings.color_text_muted | default: '#666666'
  assign color_divider = section.settings.color_divider | default: '#CCCCCC'
  assign color_tab = section.settings.color_tab | default: '#2A2E15'
  assign color_tab_active = section.settings.color_tab_active | default: '#94A857'
  assign color_tab_border = section.settings.color_tab_border | default: '#E5E5E5'
  assign color_tab_border_active = section.settings.color_tab_border_active | default: '#94A857'
  assign color_tab_heading = section.settings.color_tab_heading | default: '#2E2A22'
  assign color_tab_text = section.settings.color_tab_text | default: '#2A2E15'
  assign tab_heading_size = section.settings.tab_heading_size | default: 48
  assign tab_heading_size_mobile = section.settings.tab_heading_size_mobile | default: 32
  assign tab_body_size = section.settings.tab_body_size | default: 15
  assign tab_body_size_mobile = section.settings.tab_body_size_mobile | default: 15
  assign tab_size = section.settings.tab_size | default: 15
  assign tab_size_mobile = section.settings.tab_size_mobile | default: 14
  assign author_avatar_border_color = section.settings.author_avatar_border_color | default: '#F5C518'
  assign author_avatar_border_width = section.settings.author_avatar_border_width | default: 2
  assign author_name_color = section.settings.author_name_color | default: '#2E2A22'
  assign author_role_color = section.settings.author_role_color | default: '#5B5646'
  assign author_meta_color = section.settings.author_meta_color | default: '#4F5D45'
  assign author_meta_size = section.settings.author_meta_size | default: 15
  assign author_meta_size_mobile = section.settings.author_meta_size_mobile | default: 12
  assign before_card_bg = section.settings.before_card_bg | default: '#FBF2E1'
  assign before_card_border = section.settings.before_card_border | default: '#E7D9C0'
  assign before_checklist_border = section.settings.before_checklist_border | default: '#E7D9C0'
  assign before_days_head_bg = section.settings.before_days_head_bg | default: '#FFF0A0'
  assign before_days_border = section.settings.before_days_border | default: '#D3C4A9'
  assign before_days_label_color = section.settings.before_days_label_color | default: '#222222'
  assign before_days_text_color = section.settings.before_days_text_color | default: '#222222'
  assign before_days_label_size = section.settings.before_days_label_size | default: 20
  assign before_days_label_size_mobile = section.settings.before_days_label_size_mobile | default: 20
  assign before_days_text_size = section.settings.before_days_text_size | default: 15
  assign before_days_text_size_mobile = section.settings.before_days_text_size_mobile | default: 15
  assign before_warning_bg = section.settings.before_warning_bg | default: '#FFF0A0'
  assign ladder_heading_color = section.settings.ladder_heading_color | default: '#2E2A22'
  assign ladder_text_color = section.settings.ladder_text_color | default: '#2A2E15'
  assign ladder_link_color = section.settings.ladder_link_color | default: '#1A1A1A'
  assign ladder_desc_color = section.settings.ladder_desc_color | default: '#5B5646'
  assign ladder_heading_size = section.settings.ladder_heading_size | default: 48
  assign ladder_heading_size_mobile = section.settings.ladder_heading_size_mobile | default: 32
  assign ladder_body_size = section.settings.ladder_body_size | default: 15
  assign ladder_body_size_mobile = section.settings.ladder_body_size_mobile | default: 15
  assign ladder_item_bg = section.settings.ladder_item_bg | default: '#FBF2E1'
  assign ladder_num_bg = section.settings.ladder_num_bg | default: '#94A857'
  assign ladder_num_text = section.settings.ladder_num_text | default: '#FFFFFF'
  assign ladder_badge_bg = section.settings.ladder_badge_bg | default: '#F5D76E'
  assign ladder_note_bg = section.settings.ladder_note_bg | default: '#FFF0A0'
  assign ladder_separator_color = section.settings.ladder_separator_color | default: '#E4DBC7'
  assign ladder_radius = section.settings.ladder_radius | default: 16
  assign ladder_radius_mobile = section.settings.ladder_radius_mobile | default: 12
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --ag-pad-x: {{ padding_horizontal }}px;
    --ag-pad-x-mobile: {{ padding_horizontal_mobile }}px;
    --ag-callout-radius: {{ callout_radius }}px;
    --ag-callout-text-size: {{ callout_text_size }}px;
    --ag-callout-text-size-mobile: {{ callout_text_size_mobile }}px;
    --ag-callout-bg: {{ color_callout_bg }};
    --ag-callout-text: {{ color_callout_text }};
    --ag-link: {{ color_link }};
    --ag-bg: {{ color_bg }};
    --ag-heading: {{ color_heading }};
    --ag-text: {{ color_text }};
    --ag-text-muted: {{ color_text_muted }};
    --ag-divider: {{ color_divider }};
    --ag-author-avatar-border: {{ author_avatar_border_color }};
    --ag-author-avatar-border-width: {{ author_avatar_border_width }}px;
    --ag-author-name: {{ author_name_color }};
    --ag-author-role: {{ author_role_color }};
    --ag-author-meta: {{ author_meta_color }};
    --ag-author-meta-size: {{ author_meta_size }}px;
    --ag-author-meta-size-mobile: {{ author_meta_size_mobile }}px;
    --gt-pad-x: {{ padding_horizontal }}px;
    --gt-pad-x-mobile: {{ padding_horizontal_mobile }}px;
    --gt-heading-size: {{ tab_heading_size }}px;
    --gt-heading-size-mobile: {{ tab_heading_size_mobile }}px;
    --gt-body-size: {{ tab_body_size }}px;
    --gt-body-size-mobile: {{ tab_body_size_mobile }}px;
    --gt-tab-size: {{ tab_size }}px;
    --gt-tab-size-mobile: {{ tab_size_mobile }}px;
    --gt-heading: {{ color_tab_heading }};
    --gt-text: {{ color_tab_text }};
    --gt-link: {{ color_link }};
    --gt-tab: {{ color_tab }};
    --gt-tab-active: {{ color_tab_active }};
    --gt-tab-border: {{ color_tab_border }};
    --gt-tab-border-active: {{ color_tab_border_active }};
    --gb-card-bg: {{ before_card_bg }};
    --gb-card-border: {{ before_card_border }};
    --gb-checklist-border: {{ before_checklist_border }};
    --gb-days-head-bg: {{ before_days_head_bg }};
    --gb-days-border: {{ before_days_border }};
    --gb-days-label: {{ before_days_label_color }};
    --gb-days-text: {{ before_days_text_color }};
    --gb-days-label-size: {{ before_days_label_size }}px;
    --gb-days-label-size-mobile: {{ before_days_label_size_mobile }}px;
    --gb-days-text-size: {{ before_days_text_size }}px;
    --gb-days-text-size-mobile: {{ before_days_text_size_mobile }}px;
    --gb-warning-bg: {{ before_warning_bg }};
    --gl-heading: {{ ladder_heading_color }};
    --gl-text: {{ ladder_text_color }};
    --gl-link: {{ ladder_link_color }};
    --gl-heading-size: {{ ladder_heading_size }}px;
    --gl-heading-size-mobile: {{ ladder_heading_size_mobile }}px;
    --gl-body-size: {{ ladder_body_size }}px;
    --gl-body-size-mobile: {{ ladder_body_size_mobile }}px;
    --gl-item-bg: {{ ladder_item_bg }};
    --gl-num-bg: {{ ladder_num_bg }};
    --gl-num-text: {{ ladder_num_text }};
    --gl-badge-bg: {{ ladder_badge_bg }};
    --gl-note-bg: {{ ladder_note_bg }};
    --gl-desc: {{ ladder_desc_color }};
    --gl-radius: {{ ladder_radius }}px;
    --gl-radius-mobile: {{ ladder_radius_mobile }}px;
    --gl-separator: {{ ladder_separator_color }};
  }
{% endstyle %}

<article class="article-template">
  <div class="article-guide">
    <div class="article-guide__inner">
      <div class="article-guide__main">
        {%- assign guide_tabs_rendered = false -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="page-width page-width--narrow">
                {% render block %}
              </div>
            {%- when 'featured_image' -%}
              {%- if article.image -%}
                <div
                  class="article-template__hero-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <div
                    class="article-template__hero-{{ block.settings.image_height }} media"
                    {% if block.settings.image_height == 'adapt' and article.image %}
                      style="padding-bottom: {{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;"
                    {% endif %}
                  >
                    <img
                      srcset="
                        {% if article.image.width >= 350 %}{{ article.image | image_url: width: 350 }} 350w,{% endif %}
                        {% if article.image.width >= 750 %}{{ article.image | image_url: width: 750 }} 750w,{% endif %}
                        {% if article.image.width >= 1100 %}{{ article.image | image_url: width: 1100 }} 1100w,{% endif %}
                        {% if article.image.width >= 1500 %}{{ article.image | image_url: width: 1500 }} 1500w,{% endif %}
                        {% if article.image.width >= 2200 %}{{ article.image | image_url: width: 2200 }} 2200w,{% endif %}
                        {% if article.image.width >= 3000 %}{{ article.image | image_url: width: 3000 }} 3000w,{% endif %}
                        {{ article.image | image_url }} {{ article.image.width }}w
                      "
                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                      src="{{ article.image | image_url: width: 1100 }}"
                      loading="eager"
                      fetchpriority="high"
                      width="{{ article.image.width }}"
                      height="{{ article.image.height }}"
                      alt="{{ article.image.alt | escape }}"
                    >
                  </div>
                </div>
              {%- endif -%}

            {%- when 'table_content' -%}
              {% if block.settings.table_content != blank %}
                {% assign table_rows = block.settings.table_content | newline_to_br | split: '<br />' %}

                <div class="custom-table-wrapper">
                  <table class="custom-table">
                    {% assign header = table_rows[0] %}
                    {% assign header_cells = header | split: '|' %}

                    <thead>
                      <tr>
                        {% for cell in header_cells %}
                          <th scope="col">{{ cell | strip }}</th>
                        {% endfor %}
                      </tr>
                    </thead>

                    <tbody>
                      {% for row in table_rows %}
                        {% unless forloop.first %}
                          {% assign cells = row | split: '|' %}
                          <tr>
                            {% for cell in cells %}
                              <td>{{ cell | strip }}</td>
                            {% endfor %}
                          </tr>
                        {% endunless %}
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              {% endif %}

            {%- when 'title' -%}
              <header
                class="page-width page-width--narrow{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
                {{ block.shopify_attributes }}
              >
                <h1
                  class="article-template__title"
                >
                  {{ article.title | escape }}
                </h1>
                {%- if block.settings.blog_show_date -%}
                  <span class="circle-divider caption-with-letter-spacing">
                    {{- article.published_at | time_tag: format: 'date' -}}
                  </span>
                {%- endif -%}
                {%- if block.settings.blog_show_author -%}
                  <span class="caption-with-letter-spacing">
                    <span>{{ article.author }}</span>
                  </span>
                {%- endif -%}
              </header>

            {%- when 'content' -%}
              <div
                class="article-template__content page-width page-width--narrow rte article-guide__block article-guide__body{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                data-callout-insert-root
                {{ block.shopify_attributes }}
              >
                {{ article.content }}
              </div>

            {%- when 'share' -%}
              <div
                class="article-template__social-sharing page-width page-width--narrow{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
              >
                {% assign share_url = request.origin | append: article.url %}
                {% render 'share-button', block: block, share_link: share_url %}
              </div>

            {%- when 'author_meta' -%}
              {%- liquid
                assign author_name = block.settings.author_name | default: article.author
                assign author_role = block.settings.author_role
                assign author_image = block.settings.author_image
                assign verified_badge = block.settings.verified_badge
                assign show_date = block.settings.show_date
                assign show_reading_time = block.settings.show_reading_time
                assign date_format = block.settings.date_format
                assign reading_time_label = block.settings.reading_time_label
                if reading_time_label == blank and block.settings.reading_time_minutes != blank
                  assign reading_time_label = block.settings.reading_time_minutes | append: ' min to read'
                endif
                if reading_time_label == blank and block.settings.auto_reading_time
                  assign word_count = article.content | strip_html | split: ' ' | size
                  assign minutes = word_count | divided_by: 200 | at_least: 1
                  assign reading_time_label = minutes | append: ' min to read'
                endif
              -%}
              <div class="article-guide__block article-guide__author" {{ block.shopify_attributes }}>
                <div class="article-guide__author-identity">
                  {%- if author_image != blank -%}
                    {{
                      author_image
                      | image_url: width: 96
                      | image_tag: class: 'article-guide__avatar', loading: 'lazy', alt: author_name
                    }}
                  {%- elsif block.settings.show_avatar_placeholder -%}
                    <span class="article-guide__avatar-placeholder" aria-hidden="true"></span>
                  {%- endif -%}
                  <div class="article-guide__author-copy">
                    {%- if author_name != blank -%}
                      <h6 class="article-guide__author-name text-20-bold">
                        <span>{{ author_name | escape }}</span>
                        {%- if verified_badge != blank -%}
                          <span class="article-guide__verified">
                            {{
                              verified_badge
                              | image_url: width: 48
                              | image_tag:
                                class: 'article-guide__verified-img',
                                loading: 'lazy',
                                widths: '18, 24, 36, 48',
                                alt: verified_badge.alt
                            }}
                          </span>
                        {%- endif -%}
                      </h6>
                    {%- endif -%}
                    {%- if author_role != blank -%}
                      <p class="article-guide__author-role text-14/12">{{ author_role | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>
                {%- if show_date or show_reading_time -%}
                  <div class="article-guide__meta">
                    {%- if show_date -%}
                      <span class="article-guide__meta-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                          <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                          <path d="M3 9h18M8 3v4M16 3v4"></path>
                        </svg>
                        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                          {{ article.published_at | date: date_format }}
                        </time>
                      </span>
                    {%- endif -%}
                    {%- if show_reading_time and reading_time_label != blank -%}
                      <span class="article-guide__meta-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                          <circle cx="12" cy="12" r="9"></circle>
                          <path d="M12 7v5l3 2"></path>
                        </svg>
                        <span>{{ reading_time_label | escape }}</span>
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'callout' -%}
              {%- liquid
                assign callout_summary = block.settings.summary_text
                assign callout_body = block.settings.text
                assign callout_insert_after = block.settings.insert_after_paragraph | default: 2 | plus: 0
                if callout_insert_after < 1
                  assign callout_insert_after = 2
                endif
              -%}
              {%- if callout_summary != blank or callout_body != blank -%}
                <div
                  class="article-guide__block article-guide__callout-acc-source"
                  data-callout-acc-source
                  data-callout-insert-after="{{ callout_insert_after }}"
                  {{ block.shopify_attributes }}
                >
                  <details class="article-guide__callout-acc" data-callout-acc>
                    <summary class="article-guide__callout-acc-summary">
                      {%- if block.settings.icon != blank -%}
                        <span class="article-guide__callout-acc-icon" aria-hidden="true">
                          {{
                            block.settings.icon
                            | image_url: width: 68
                            | image_tag:
                              class: 'article-guide__callout-acc-icon-img',
                              loading: 'lazy',
                              widths: '34, 48, 68',
                              alt: block.settings.icon.alt
                          }}
                        </span>
                      {%- endif -%}
                      <span class="article-guide__callout-acc-label">
                        {%- if callout_summary != blank -%}
                          {{ callout_summary }}
                        {%- endif -%}
                      </span>
                      <span class="article-guide__callout-acc-toggle" aria-hidden="true">
                        <svg
                          class="article-guide__callout-acc-toggle-open"
                          width="17"
                          height="20"
                          viewBox="0 0 17 20"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                          aria-hidden="true"
                        >
                          <path d="M15.814 6.07966L17 10.5031L11.0282 12.1384L12.1518 19.3082L7.65728 20L6.6377 13.2914L1.18605 14.8008L0 10.3774L5.97185 8.74214L4.76499 0.67086L9.19706 0L10.3415 7.54717L15.814 6.07966Z" fill="#7E3253"/>
                        </svg>
                        <svg
                          class="article-guide__callout-acc-toggle-close"
                          width="17"
                          height="20"
                          viewBox="0 0 17 20"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                          aria-hidden="true"
                        >
                          <path d="M1 7H16V13H1V7Z" fill="#7E3253"/>
                        </svg>
                      </span>
                    </summary>
                    {%- if callout_body != blank -%}
                      <div class="article-guide__callout-acc-panel">
                        {{ callout_body }}
                      </div>
                    {%- endif -%}
                  </details>
                </div>
              {%- endif -%}

            {%- when 'tab' -%}
              {%- unless guide_tabs_rendered -%}
                {%- assign guide_tabs_rendered = true -%}
                {% render 'article-guide.tabs' %}
              {%- endunless -%}

            {%- when 'ladder' -%}
              <div class="article-guide__block" {{ block.shopify_attributes }}>
                {% render 'article-guide.ladder',
                  ladder_heading: block.settings.heading,
                  ladder_disclaimer: block.settings.content
                %}
              </div>

            {%- when 'ladder_step' -%}
              {% comment %} Steps render via article-guide.ladder snippet {% endcomment %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="article-template__back element-margin-top center{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <a href="{{ blog.url }}" class="article-template__link link animate-arrow">
      <span class="icon-wrap">
        <span class="svg-wrapper">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      </span>
      {{ 'blogs.article.back_to_blog' | t: title: blog.title | escape }}
    </a>
  </div>
  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper background-secondary">
      <div
        id="comments"
        class="page-width page-width--narrow{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      >
        {%- if article.comments_count > 0 -%}
          {%- assign anchorId = '#Comments-' | append: article.id -%}

          <h2 id="Comments-{{ article.id }}" tabindex="-1">
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </h2>
          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- if comment.status == 'pending' and comment.content -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                  </footer>
                </article>
              {%- endif -%}

              {%- for comment in article.comments -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span
                    ><span class="caption-with-letter-spacing">
                      {{- comment.created_at | time_tag: format: 'date' -}}
                    </span>
                  </footer>
                </article>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: anchorId %}
            </div>
          {% endpaginate %}
        {%- endif -%}
        {% form 'new_comment', article %}
          {%- liquid
            assign post_message = 'blogs.article.success'
            if blog.moderated? and comment.status == 'unapproved'
              assign post_message = 'blogs.article.success_moderated'
            endif
          -%}
          <h2>{{ 'blogs.article.comment_form_title' | t }}</h2>
          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
            <ul class="form-status-list caption-large">
              {%- for field in form.errors -%}
                <li>
                  <a href="#CommentForm-{{ field }}" class="link">
                    {%- if form.errors.translated_fields[field] contains 'author' -%}
                      {{ 'blogs.article.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                      {{ 'blogs.article.message' | t }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-success.svg' | inline_asset_content -}}
                </span>
                {{ post_message | t }}
              </h3>
            </div>
          {%- endif -%}

          <div
            {% if blog.moderated? == false %}
              class="article-template__comments-fields"
            {% endif %}
          >
            <div class="article-template__comment-fields">
              <div class="field field--with-error">
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentForm-author"
                  class="field__input"
                  autocomplete="name"
                  value="{{ form.author }}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-author-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.name' | t }}"
                >
                <label class="field__label" for="CommentForm-author">
                  {{- 'blogs.article.name' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'author' -%}
                  <small id="CommentForm-author-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.name' | t }}
                      {{ form.errors.messages.author }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
              <div class="field field--with-error">
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentForm-email"
                  autocomplete="email"
                  class="field__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-email-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.email' | t }}"
                >
                <label class="field__label" for="CommentForm-email">
                  {{- 'blogs.article.email' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'email' -%}
                  <small id="CommentForm-email-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.email' | t }}
                      {{ form.errors.messages.email }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
            </div>
            <div class="field field--with-error">
              <textarea
                rows="5"
                name="comment[body]"
                id="CommentForm-body"
                class="text-area field__input"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
                placeholder="{{ 'blogs.article.message' | t }}"
              >{{ form.body }}</textarea>
              <label class="form__label field__label" for="CommentForm-body">
                {{- 'blogs.article.message' | t }}
                <span aria-hidden="true">*</span></label
              >
            </div>
            {%- if form.errors contains 'body' -%}
              <small id="CommentForm-body-error">
                <span class="form__message">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- 'blogs.article.message' | t }}
                  {{ form.errors.messages.body }}.</span
                >
              </small>
            {%- endif -%}
          </div>
          {%- if blog.moderated? -%}
            <p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}
          <input type="submit" class="button" value="{{ 'blogs.article.post' | t }}">
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

