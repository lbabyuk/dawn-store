{{ 'marquee-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .image-marquee-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    --marquee-speed: {{ section.settings.speed }}s;
    --marquee-gap: {{ section.settings.gap }}px;
    --marquee-img-height: {{ section.settings.image_height }}px;
  }
{%- endstyle -%}

<div 
  class="image-marquee-wrapper" 
  data-pause-on-hover="{{ section.settings.pause_on_hover }}"
  data-grayscale="{{ section.settings.grayscale }}"
>
  <div class="image-marquee-track">
    {% for i in (1..2) %}
      <div class="image-marquee-group">
        {% for repeat in (1..3) %}
          {% for block in section.blocks %}
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="image-marquee-item" {{ block.shopify_attributes }}>
            {% else %}
              <div class="image-marquee-item" {{ block.shopify_attributes }}>
            {% endif %}

              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 600 | image_tag: 
                  loading: 'lazy',
                  alt: block.settings.image.alt | default: 'Marquee Image'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Image Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Image max height",
      "default": 40
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "default": 25
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Gap between images",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Grayscale images (color on hover)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause animation on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Marquee Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Marquee",
      "blocks": [
        { "type": "image_block" },
        { "type": "image_block" },
        { "type": "image_block" },
        { "type": "image_block" }
      ]
    }
  ]
}
{% endschema %}