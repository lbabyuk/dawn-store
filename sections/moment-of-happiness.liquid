
{% liquid
  assign section_id = 'moment-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="moment-section"
  style="
    --moment-bg: {{ section.settings.background_color }};
    --moment-text: {{ section.settings.text_color }};
    --moment-accent: {{ section.settings.accent_color }};
    --moment-radius: {{ section.settings.image_radius }}px;
    --moment-padding-top: {{ section.settings.padding_top }}px;
    --moment-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="moment-section__inner page-width">

    <!-- TEXT CONTENT -->
    <div class="moment-section__content">

      {% if section.settings.eyebrow != blank %}
        <p class="moment-section__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h2 class="moment-section__heading">
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.description != blank %}
        <div class="moment-section__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="moment-section__decoration">
        <span></span>
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M16 27C12 22 3 16 4 9C5 2 14 3 16 11C19 3 28 2 29 9C30 16 20 23 16 27Z"
            stroke="currentColor" stroke-width="1.5"/>
        </svg>
        <span></span>
      </div>

      <div class="moment-section__features">
        {% for block in section.blocks %}
          <div class="moment-feature" {{ block.shopify_attributes }}>

            <div class="moment-feature__icon">
              {% case block.settings.icon %}
                {% when 'coffee' %}
                  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                    <path d="M10 19H35V31C35 36 31 39 25 39H20C14 39 10 35 10 30V19Z"
                      stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M35 22H39C45 22 44 31 35 31"
                      stroke="currentColor" stroke-width="1.8"/>
                    <path d="M17 13C13 9 20 8 17 4M26 13C22 9 29 8 26 4"
                      stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>

                {% when 'cake' %}
                  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                    <path d="M7 28L24 14L41 28V39H7V28Z"
                      stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M7 28C13 34 18 23 24 29C30 35 35 24 41 29"
                      stroke="currentColor" stroke-width="1.8"/>
                    <path d="M24 14V8M21 9C21 5 27 5 27 9"
                      stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>

                {% when 'gift' %}
                  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                    <path d="M8 21H40V40H8V21Z" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M6 15H42V21H6V15Z" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M24 15V40M24 15C10 16 9 7 16 7C22 7 24 15 24 15ZM24 15C38 16 39 7 32 7C26 7 24 15 24 15Z"
                      stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  </svg>

                {% when 'heart' %}
                  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                    <path d="M24 40S5 28 5 16C5 5 19 3 24 15C29 3 43 5 43 16C43 28 24 40 24 40Z"
                      stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  </svg>
              {% endcase %}
            </div>

            <div class="moment-feature__text">
              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p>{{ block.settings.description }}</p>
              {% endif %}
            </div>

          </div>
        {% endfor %}
      </div>

      {% if section.settings.button_label != blank %}
        <a
          class="moment-section__button"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.button_label }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}

    </div>

    <!-- IMAGE COLLAGE -->
    <div class="moment-section__gallery">

      <div class="moment-image moment-image--main">
        {% if section.settings.main_image != blank %}
          {{
            section.settings.main_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '500, 750, 1000, 1400',
              alt: section.settings.main_image.alt
          }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'moment-placeholder' }}
        {% endif %}
      </div>

      <div class="moment-image moment-image--top">
        {% if section.settings.top_image != blank %}
          {{
            section.settings.top_image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '300, 500, 800',
              alt: section.settings.top_image.alt
          }}
        {% else %}
          {{ 'product-2' | placeholder_svg_tag: 'moment-placeholder' }}
        {% endif %}
      </div>

      <div class="moment-image moment-image--bottom">
        {% if section.settings.bottom_image != blank %}
          {{
            section.settings.bottom_image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '300, 500, 800',
              alt: section.settings.bottom_image.alt
          }}
        {% else %}
          {{ 'product-3' | placeholder_svg_tag: 'moment-placeholder' }}
        {% endif %}
      </div>

      <div class="moment-image moment-image--left">
        {% if section.settings.left_image != blank %}
          {{
            section.settings.left_image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '300, 500, 800',
              alt: section.settings.left_image.alt
          }}
        {% else %}
          {{ 'product-4' | placeholder_svg_tag: 'moment-placeholder' }}
        {% endif %}
      </div>

    </div>

  </div>
</section>

<style>
  #{{ section_id }} {
    background: var(--moment-bg);
    color: var(--moment-text);
    padding-top: var(--moment-padding-top);
    padding-bottom: var(--moment-padding-bottom);
    overflow: hidden;
  }

  #{{ section_id }} .moment-section__inner {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: 45px;
  }

  /* CONTENT */

  #{{ section_id }} .moment-section__content {
    position: relative;
    z-index: 2;
    max-width: 440px;
  }

  #{{ section_id }} .moment-section__eyebrow {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 18px;
    color: var(--moment-accent);
  }

  #{{ section_id }} .moment-section__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(42px, 5vw, 76px);
    line-height: 0.98;
    font-weight: 400;
    letter-spacing: -0.045em;
    margin: 0;
    color: var(--moment-text);
  }

  #{{ section_id }} .moment-section__description {
    font-size: 17px;
    line-height: 1.65;
    margin-top: 24px;
    max-width: 340px;
  }

  #{{ section_id }} .moment-section__description p {
    margin: 0;
  }

  #{{ section_id }} .moment-section__decoration {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 220px;
    margin: 26px 0 30px;
    color: var(--moment-accent);
  }

  #{{ section_id }} .moment-section__decoration span {
    height: 1px;
    background: currentColor;
    flex: 1;
  }

  #{{ section_id }} .moment-section__decoration svg {
    width: 28px;
    height: 28px;
  }

  /* FEATURES */

  #{{ section_id }} .moment-section__features {
    display: grid;
    gap: 18px;
  }

  #{{ section_id }} .moment-feature {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  #{{ section_id }} .moment-feature__icon {
    width: 64px;
    height: 64px;
    min-width: 64px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--moment-accent) 12%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section_id }} .moment-feature__icon svg {
    width: 34px;
    height: 34px;
  }

  #{{ section_id }} .moment-feature__text h3 {
    font-size: 17px;
    font-weight: 500;
    margin: 0 0 3px;
    color: var(--moment-text);
  }

  #{{ section_id }} .moment-feature__text p {
    font-size: 14px;
    line-height: 1.45;
    margin: 0;
    opacity: 0.8;
  }

  /* BUTTON */

  #{{ section_id }} .moment-section__button {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
    padding: 14px 26px;
    background: var(--moment-text);
    color: var(--moment-bg);
    border-radius: 50px;
    text-decoration: none;
    font-size: 14px;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  #{{ section_id }} .moment-section__button:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  /* GALLERY */

  #{{ section_id }} .moment-section__gallery {
    position: relative;
    min-height: 620px;
    width: 100%;
  }

  #{{ section_id }} .moment-image {
    position: absolute;
    overflow: hidden;
    border-radius: var(--moment-radius);
    animation: momentFadeIn 0.8s ease both;
  }

  #{{ section_id }} .moment-image img,
  #{{ section_id }} .moment-image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ section_id }} .moment-placeholder {
    background: #e8d6c5;
  }

  #{{ section_id }} .moment-image--main {
    width: 65%;
    height: 75%;
    left: 5%;
    top: 12%;
    z-index: 2;
    transform: rotate(-3deg);
  }

  #{{ section_id }} .moment-image--top {
    width: 37%;
    height: 42%;
    right: 1%;
    top: 0;
    z-index: 3;
    transform: rotate(4deg);
    animation-delay: 0.12s;
  }

  #{{ section_id }} .moment-image--bottom {
    width: 38%;
    height: 43%;
    right: 0;
    bottom: 0;
    z-index: 3;
    transform: rotate(4deg);
    animation-delay: 0.24s;
  }

  #{{ section_id }} .moment-image--left {
    width: 43%;
    height: 42%;
    left: 0;
    bottom: -2%;
    z-index: 3;
    transform: rotate(-5deg);
    animation-delay: 0.36s;
  }

  #{{ section_id }} .moment-decoration {
    position: absolute;
    color: var(--moment-accent);
    z-index: 4;
    pointer-events: none;
  }

  #{{ section_id }} .moment-decoration--heart {
    right: 1%;
    top: 48%;
    font-size: 65px;
    transform: rotate(15deg);
  }

  #{{ section_id }} .moment-decoration--sparkle {
    left: 55%;
    top: 5%;
    font-size: 40px;
  }

  @keyframes momentFadeIn {
    from {
      opacity: 0;
      translate: 0 20px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* RESPONSIVE */

  @media screen and (max-width: 989px) {
    #{{ section_id }} .moment-section__inner {
      grid-template-columns: 1fr 1fr;
      gap: 25px;
    }

    #{{ section_id }} .moment-section__gallery {
      min-height: 480px;
    }

    #{{ section_id }} .moment-section__heading {
      font-size: clamp(38px, 5vw, 55px);
    }

    #{{ section_id }} .moment-feature__icon {
      width: 52px;
      height: 52px;
      min-width: 52px;
    }

    #{{ section_id }} .moment-feature__icon svg {
      width: 28px;
      height: 28px;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-top: calc(var(--moment-padding-top) * 0.7);
      padding-bottom: calc(var(--moment-padding-bottom) * 0.7);
    }

    #{{ section_id }} .moment-section__inner {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    #{{ section_id }} .moment-section__content {
      max-width: 100%;
    }

    #{{ section_id }} .moment-section__heading {
      font-size: clamp(42px, 11vw, 60px);
      max-width: 480px;
    }

    #{{ section_id }} .moment-section__description {
      font-size: 15px;
      margin-top: 18px;
    }

    #{{ section_id }} .moment-section__decoration {
      margin: 20px 0;
    }

    #{{ section_id }} .moment-section__features {
      grid-template-columns: 1fr 1fr;
      gap: 20px 12px;
    }

    #{{ section_id }} .moment-feature {
      gap: 10px;
      align-items: flex-start;
    }

    #{{ section_id }} .moment-feature__icon {
      width: 42px;
      height: 42px;
      min-width: 42px;
    }

    #{{ section_id }} .moment-feature__icon svg {
      width: 24px;
      height: 24px;
    }

    #{{ section_id }} .moment-feature__text h3 {
      font-size: 14px;
    }

    #{{ section_id }} .moment-feature__text p {
      font-size: 12px;
    }

    #{{ section_id }} .moment-section__gallery {
      min-height: 390px;
      margin: 0 auto;
      max-width: 550px;
    }

    #{{ section_id }} .moment-image--main {
      width: 66%;
      height: 75%;
      left: 5%;
      top: 12%;
    }

    #{{ section_id }} .moment-image--top {
      width: 37%;
      height: 40%;
      right: 0;
    }

    #{{ section_id }} .moment-image--bottom {
      width: 37%;
      height: 42%;
    }

    #{{ section_id }} .moment-image--left {
      width: 43%;
      height: 39%;
    }

    #{{ section_id }} .moment-decoration--heart {
      font-size: 42px;
    }

    #{{ section_id }} .moment-decoration--sparkle {
      font-size: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .moment-image {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "A little moment",
  "tag": "section",
  "class": "section-moment-happiness",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A sweet little escape"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little moment of happiness"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>More than just dessert — it's a sweet pause in your day.</p>"
    },
    {
      "type": "header",
      "content": "Gallery images"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main image"
    },
    {
      "type": "image_picker",
      "id": "top_image",
      "label": "Top right image"
    },
    {
      "type": "image_picker",
      "id": "bottom_image",
      "label": "Bottom right image"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Bottom left image"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore our treats"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8EFE5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#492514"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#89552F"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Occasion",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "coffee", "label": "Coffee" },
            { "value": "cake", "label": "Cake" },
            { "value": "gift", "label": "Gift" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "coffee"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Your morning treat"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "A sweet start to your day"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "A little moment of happiness",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "coffee",
            "title": "Your morning treat",
            "description": "A sweet start to your day"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "cake",
            "title": "A sweet afternoon break",
            "description": "Take a moment just for you"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "gift",
            "title": "Something to share",
            "description": "Make every moment special"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "heart",
            "title": "A little reward",
            "description": "Because you deserve it"
          }
        }
      ]
    }
  ]
}
{% endschema %}
