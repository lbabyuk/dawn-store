{% comment %}
  Custom FAQ Accordion Section with Side Image
  Designed for Shopify Dawn Theme
{% endcomment %}

{{ 'section-custom-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-custom-faq.js' | asset_url }}" defer="defer"></script>

<div
  class="custom-faq-wrapper section-{{ section.id }}-padding"
  id="shopify-section-{{ section.id }}"
  data-section-type="custom-faq"
  data-auto-close="{{ section.settings.auto_close_others }}"
  style="
    --faq-bg-color: {{ section.settings.bg_color }};
    --faq-heading-color: {{ section.settings.heading_color }};
    --faq-accent-color: {{ section.settings.accent_color }};
    --faq-text-color: {{ section.settings.text_color }};
    --faq-item-title-color: {{ section.settings.item_title_color }};
    --faq-card-bg-color: {{ section.settings.card_bg_color }};
    --faq-card-border-color: {{ section.settings.card_border_color }};
    --faq-card-active-bg-color: {{ section.settings.card_active_bg_color }};
    --faq-card-active-border-color: {{ section.settings.card_active_border_color }};
    background-color: var(--faq-bg-color);
  "
>
  <div class="page-width">
    <div class="custom-faq__header">
      {%- if section.settings.subheading != blank -%}
        <div class="custom-faq__subheading rte">
          {{ section.settings.subheading }}
        </div>
        <div class="custom-faq__subheading-wrapper">
          <span class="custom-faq__subheading-line"></span>
          {%- if section.settings.subheading_icon != blank -%}
            <img
              src="{{ section.settings.subheading_icon | image_url: width: 60 }}"
              alt="{{ section.settings.subheading | strip_html }}"
              class="custom-faq__subheading-icon-img"
              loading="lazy"
              width="22"
              height="22"
            >
          {%- else -%}
            <span class="custom-faq__subheading-default-icon">
              {{ 'icon-apple.svg' | inline_asset_content }}
            </span>
          {%- endif -%}
          <span class="custom-faq__subheading-line"></span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="custom-faq__title custom-faq__heading-font rte {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="custom-faq__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    <div class="custom-faq__grid">
      <custom-faq data-auto-close="{{ section.settings.auto_close_others }}">
        <div class="custom-faq__accordions">
          {%- for block in section.blocks -%}
            <div
              class="custom-faq__item{% if forloop.first and section.settings.open_first_item %} is-open{% endif %}"
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="custom-faq__trigger"
                aria-expanded="{% if forloop.first and section.settings.open_first_item %}true{% else %}false{% endif %}"
                aria-controls="faq-content-{{ block.id }}"
              >
                <div class="custom-faq__trigger-header">
                  {%- if block.settings.item_icon != blank -%}
                    <img
                      src="{{ block.settings.item_icon | image_url: width: 80 }}"
                      alt="{{ block.settings.title | strip_html }}"
                      class="custom-faq__item-icon-img"
                      loading="lazy"
                      width="32"
                      height="32"
                    >
                  {%- endif -%}

                  <div class="custom-faq__item-title custom-faq__heading-font rte">
                    {{ block.settings.title }}
                  </div>
                </div>

                <span class="custom-faq__chevron">
                  <svg
                    viewBox="0 0 24 24"
                    width="22"
                    height="22"
                    stroke="currentColor"
                    stroke-width="2.5"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </button>

              <div
                id="faq-content-{{ block.id }}"
                class="custom-faq__content"
                {% unless forloop.first and section.settings.open_first_item %}
                  hidden
                {% endunless %}
              >
                <div class="custom-faq__content-inner rte">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </custom-faq>

      {%- comment -%} SIDE IMAGE COLUMN {%- endcomment -%}
      <div class="custom-faq__image-wrapper">
        {%- if section.settings.side_image != blank -%}
          <div class="custom-faq__media media">
            {{
              section.settings.side_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 990px) 50vw, 100vw',
                widths: '375, 550, 750, 1100, 1500',
                class: 'custom-faq__image'
            }}
          </div>
        {%- else -%}
          <div class="custom-faq__media media media--placeholder">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom FAQ with Image",
  "tag": "section",
  "class": "section-custom-faq",
  "settings": [
    {
      "type": "header",
      "content": "Header Settings"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>FIND JOY IN EVERY BITE</p>"
    },
    {
      "type": "image_picker",
      "id": "subheading_icon",
      "label": "Subheading Icon Image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "A LITTLE SWEETNESS GOES A LONG WAY"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We put care into every detail — from selecting the finest ingredients to creating flavors that brighten your day.</p>"
    },
    {
      "type": "header",
      "content": "Side Image"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Side Image"
    },
    {
      "type": "header",
      "content": "Behavior Settings"
    },
    {
      "type": "checkbox",
      "id": "open_first_item",
      "label": "Open first FAQ item by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_close_others",
      "label": "Collapse other items when opening one",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FAF8F6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#D91C0B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Lines & Chevron)",
      "default": "#D91C0B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color",
      "default": "#4A4A4A"
    },
    {
      "type": "color",
      "id": "item_title_color",
      "label": "Accordion Title Color",
      "default": "#D91C0B"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border",
      "default": "#EFEFEF"
    },
    {
      "type": "color",
      "id": "card_active_bg_color",
      "label": "Active Card Background",
      "default": "#FFF8F8"
    },
    {
      "type": "color",
      "id": "card_active_border_color",
      "label": "Active Card Border",
      "default": "#E24C3E"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "richtext",
          "id": "title",
          "label": "Accordion Title",
          "default": "<p>OUR INGREDIENTS</p>"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Accordion Content",
          "default": "<p>We use carefully selected ingredients to create sweets with a bright, natural flavor.</p>"
        },
        {
          "type": "image_picker",
          "id": "item_icon",
          "label": "Item Icon Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom FAQ with Image",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "title": "<p>OUR INGREDIENTS</p>",
            "answer": "<p>We use carefully selected ingredients to create sweets with a bright, natural citrus flavor.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "<p>OUR FLAVORS</p>",
            "answer": "<p>Bright, balanced, and unforgettable. Our flavors bring a burst of sunshine to every bite.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "<p>OUR PHILOSOPHY</p>",
            "answer": "<p>Crafted with patience and love, ensuring every piece delivers the ultimate delight.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
