{%- comment -%}
  sections/bundle-builder.liquid
  Bundle builder for Dawn.
  Swiper 11 is loaded from theme assets: swiper-bundle.min.css and swiper-bundle.min.js
  (rename the two files below if yours are called differently).
{%- endcomment -%}

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'bundle-builder.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign tier_blocks = section.blocks | where: 'type', 'tier'
-%}

<style>
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.padding_top }}px;
    margin-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .bb {
    --bb-accent: {{ section.settings.accent_color }};
    --bb-ok: {{ section.settings.ok_color }};
    --bb-warn: {{ section.settings.warn_color }};
    --bb-border: #d4d7e2;
    --bb-muted: #6b7280;
    --bb-surface: #e5e8ee;
    --bb-accent-font: 'Playfair Display', Georgia, 'Times New Roman', serif;
    color: #1b1f2a;
  }
</style>

<bundle-builder class="bb" data-section-id="{{ section.id }}">
  <script type="application/json" data-bb-config>
    {
      "currency": {{ cart.currency.iso_code | json }},
      "locale": {{ request.locale.iso_code | json }},
      "swiperUrl": {{ 'swiper-bundle.min.js' | asset_url | json }},
      "tiers": [
        {%- if tier_blocks.size > 0 -%}
          {%- assign tier_first = true -%}
          {%- for block in tier_blocks -%}
            {%- unless tier_first -%},{%- endunless -%}
            {%- assign tier_first = false -%}
            { "qty": {{ block.settings.qty }}, "percent": {{ block.settings.percent }}, "code": {{ block.settings.code | json }} }
          {%- endfor -%}
        {%- else -%}
          { "qty": {{ section.settings.tier_1_qty | default: 3 }}, "percent": {{ section.settings.tier_1_percent | default: 5 }}, "code": {{ section.settings.tier_1_code | json }} },
          { "qty": {{ section.settings.tier_2_qty | default: 5 }}, "percent": {{ section.settings.tier_2_percent | default: 10 }}, "code": {{ section.settings.tier_2_code | json }} },
          { "qty": {{ section.settings.tier_3_qty | default: 7 }}, "percent": {{ section.settings.tier_3_percent | default: 15 }}, "code": {{ section.settings.tier_3_code | json }} }
        {%- endif -%}
      ],
      "steps": [
        {%- assign step_first = true -%}
        {%- for block in step_blocks -%}
          {%- if block.settings.products != blank -%}
            {%- unless step_first -%},{%- endunless -%}
            {%- assign step_first = false -%}
            { "id": {{ block.id | json }}, "title": {{ block.settings.title | json }}, "min": {{ block.settings.min_items }}, "max": {{ block.settings.max_items }} }
          {%- endif -%}
        {%- endfor -%}
      ],
      "text": {
        "addMore": {{ section.settings.text_add_more | json }},
        "unlocked": {{ section.settings.text_unlocked | json }},
        "required": {{ section.settings.text_required | json }},
        "atLeast": {{ section.settings.text_at_least | json }},
        "optional": {{ section.settings.text_optional | json }},
        "added": {{ section.settings.text_added | json }},
        "error": {{ section.settings.text_error | json }},
        "soldOut": {{ section.settings.text_sold_out | json }},
        "stockLimit": {{ section.settings.text_stock_limit | json }}
      }
    }
  </script>

  <div class="page-width">
    <div class="bb__head">
      <h2 class="bb__title">
        {%- if section.settings.heading_accent != blank -%}<em>{{ section.settings.heading_accent }}</em>{%- endif %}
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="bb__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="bb__layout">
      <div class="bb__main">

        {%- comment -%} TABS (swiper) — only steps with products {%- endcomment -%}
        {%- assign tab_index = 0 -%}
        <div class="bb-tabs">
          <div class="swiper bb-tabs__swiper" data-bb-tabs>
            <div class="swiper-wrapper" role="tablist">
              {%- for block in step_blocks -%}
                {%- if block.settings.products != blank -%}
                  <div class="swiper-slide bb-tabs__slide" {{ block.shopify_attributes }}>
                    <button type="button" role="tab" class="bb-tab{% if tab_index == 0 %} is-active{% endif %}" data-action="tab" data-index="{{ tab_index }}" aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}">
                      <span class="bb-tab__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                          {%- case block.settings.icon -%}
                            {%- when 'moon' -%}<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
                            {%- when 'sparkle' -%}<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 17v4M17 19h4"/>
                            {%- when 'drop' -%}<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>
                            {%- else -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
                          {%- endcase -%}
                        </svg>
                      </span>
                      {{ block.settings.title }}
                    </button>
                  </div>
                  {%- assign tab_index = tab_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="bb-tabs__nav">
            <button type="button" class="bb-tabs__arrow" data-action="step-prev" aria-label="Previous step">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
            </button>
            <button type="button" class="bb-tabs__arrow" data-action="step-next" aria-label="Next step">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>

        {%- comment -%} PANELS (one per step with products) {%- endcomment -%}
        {%- assign panel_index = 0 -%}
        {%- for block in step_blocks -%}
          {%- if block.settings.products != blank -%}
            {%- assign step_products = block.settings.products -%}
            <div class="bb-panel" role="tabpanel" data-panel="{{ block.id }}" {% unless panel_index == 0 %}hidden{% endunless %}>
              <div class="swiper bb-slider" data-bb-slider>
                <div class="swiper-wrapper">
                  {%- for product in step_products -%}
                    {%- assign variant = product.selected_or_first_available_variant -%}
                    <div class="swiper-slide">
                      <div class="bb-card{% unless product.available %} is-soldout{% endunless %}"
                        data-card
                        data-step="{{ block.id }}"
                        data-title="{{ product.title | escape }}"
                        data-image="{{ product.featured_image | image_url: width: 160 }}"
                        data-zoom="{{ product.featured_image | image_url: width: 1200 }}"
                        data-variant-id="{{ variant.id }}"
                        data-price="{{ variant.price }}"
                        data-available="{{ variant.available }}"
                        data-inventory="{{ variant.inventory_quantity }}"
                        data-inventory-policy="{{ variant.inventory_policy }}"
                        data-inventory-management="{{ variant.inventory_management }}"
                        data-product-available="{{ product.available }}">
                        <div class="bb-card__media">
                          {%- if product.featured_image -%}
                            {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 45vw', alt: product.title }}
                          {%- endif -%}
                          {%- if product.available -%}
                            <button type="button" class="bb-card__zoom" data-action="zoom" aria-label="Zoom {{ product.title | escape }}">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2M11 8.5v5M8.5 11h5"/></svg>
                            </button>
                          {%- else -%}
                            <p class="bb-card__soldout">{{ section.settings.text_sold_out | default: 'Sold out' }}</p>
                          {%- endif -%}
                        </div>
                        <div class="bb-card__body">
                          <h3 class="bb-card__title">{{ product.title }}</h3>
                          <p class="bb-card__price">{{ variant.price | money }}</p>
                          {%- unless product.has_only_default_variant -%}
                            <select class="bb-card__variant" data-variant-select aria-label="Variant" {% unless product.available %}disabled{% endunless %}>
                              {%- for v in product.variants -%}
                                <option
                                  value="{{ v.id }}"
                                  data-price="{{ v.price }}"
                                  data-title="{{ v.title | escape }}"
                                  data-available="{{ v.available }}"
                                  data-inventory="{{ v.inventory_quantity }}"
                                  data-inventory-policy="{{ v.inventory_policy }}"
                                  data-inventory-management="{{ v.inventory_management }}"
                                  {% unless v.available %}disabled{% endunless %}
                                  {% if v.id == variant.id %}selected{% endif %}
                                >{{ v.title }}</option>
                              {%- endfor -%}
                            </select>
                          {%- endunless -%}
                          <p class="bb-card__hint" data-stock-hint></p>
                        </div>
                        {%- if product.available -%}
                          <div class="bb-qty">
                            <button type="button" data-action="dec" aria-label="Decrease quantity" disabled>&minus;</button>
                            <span data-qty aria-live="polite">0</span>
                            <button type="button" data-action="inc" aria-label="Increase quantity">+</button>
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            </div>
            {%- assign panel_index = panel_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} BUNDLE CONTENTS {%- endcomment -%}
      <aside class="bb-sum" data-sum aria-label="Bundle Contents">
        <h3 class="bb-sum__title">{{ section.settings.summary_title }}</h3>
        <div class="bb-sum__row">
          <p class="bb-sum__msg" data-msg aria-live="polite"></p>
          <button type="button" class="bb-sum__toggle" data-action="toggle" aria-expanded="false" aria-label="Toggle bundle contents">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M12 4v16M4 12h16"/></svg>
          </button>
        </div>

        <div class="bb-progress">
          <div class="bb-progress__track">
            <div class="bb-progress__fill" data-fill></div>
            {%- if tier_blocks.size > 0 -%}
              {%- assign tier_count = tier_blocks.size -%}
              {%- for block in tier_blocks -%}
                {%- assign pos = forloop.index0 | times: 2 | plus: 1 | times: 100.0 | divided_by: tier_count | divided_by: 2 -%}
                <span class="bb-node" data-node style="left: {{ pos }}%" {{ block.shopify_attributes }}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
                  <span class="bb-node__label">{{ block.settings.percent }}% off</span>
                </span>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..3) -%}
                {%- liquid
                  assign pos = forloop.index0 | times: 2 | plus: 1 | times: 16.6667
                  case i
                    when 1
                      assign pct = section.settings.tier_1_percent | default: 5
                    when 2
                      assign pct = section.settings.tier_2_percent | default: 10
                    else
                      assign pct = section.settings.tier_3_percent | default: 15
                  endcase
                -%}
                <span class="bb-node" data-node style="left: {{ pos }}%">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
                  <span class="bb-node__label">{{ pct }}% off</span>
                </span>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        <div class="bb-sum__contents"><div class="bb-sum__contents-inner" data-groups></div></div>

        <div class="bb-sum__total">
          <span>{{ section.settings.text_total }}</span>
          <span data-total><strong>{{ 0 | money }}</strong></span>
        </div>
        <button type="button" class="bb-btn" data-action="add" disabled>
          <span class="bb-btn__label">{{ section.settings.text_button }}</span>
          <span class="bb-btn__spinner" aria-hidden="true"></span>
        </button>
        <p class="bb-sum__error" data-error role="alert"></p>
      </aside>
    </div>
  </div>

  <dialog class="bb-zoom" data-zoom-dialog>
    <button type="button" class="bb-zoom__close" data-action="close-zoom" aria-label="Close">&times;</button>
    <img alt="" data-zoom-img>
  </dialog>
</bundle-builder>

<script>
  (() => {
    if (customElements.get('bundle-builder')) return;

    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const tpl = (str, vars) => String(str).replace(/\{(\w+)\}/g, (_, k) => (vars[k] ?? ''));

    // Loads Swiper from theme assets once, even with several sections on the page
    let swiperPromise;
    const loadSwiper = (url) => {
      if (window.Swiper) return Promise.resolve(window.Swiper);
      if (!swiperPromise) {
        swiperPromise = new Promise((resolve, reject) => {
          const s = document.createElement('script');
          s.src = url;
          s.onload = () => resolve(window.Swiper);
          s.onerror = () => reject(new Error('Swiper failed to load'));
          document.head.appendChild(s);
        });
      }
      return swiperPromise;
    };

    class BundleBuilder extends HTMLElement {
      connectedCallback() {
        if (this.ready) return;
        this.ready = true;

        this.cfg = JSON.parse(this.querySelector('[data-bb-config]').textContent);
        try {
          this.money = new Intl.NumberFormat(this.cfg.locale, { style: 'currency', currency: this.cfg.currency });
        } catch (e) {
          this.money = new Intl.NumberFormat(undefined, { style: 'currency', currency: this.cfg.currency });
        }

        this.items = new Map(); // key: `${stepId}|${variantId}`
        this.open = new Set(this.cfg.steps.length ? [this.cfg.steps[0].id] : []);
        this.sum = this.querySelector('[data-sum]');
        this.tabs = [...this.querySelectorAll('[data-action="tab"]')];
        this.panels = [...this.querySelectorAll('[data-panel]')];
        this.current = 0;

        this.bind();
        this.buildGroups();
        this.updateArrows();
        this.render();
        this.openDrawerAfterDiscount();

        loadSwiper(this.cfg.swiperUrl)
          .then(() => this.initSwipers())
          .catch((err) => console.warn('[bundle-builder]', err));
      }

      openCartDrawer(parsedState) {
        const cart = document.querySelector('cart-drawer');
        if (!cart) return false;
        if (parsedState && typeof cart.renderContents === 'function' && parsedState.sections) {
          cart.renderContents(parsedState);
        } else if (typeof cart.open === 'function') {
          cart.open();
        } else {
          cart.classList.add('active');
          document.body.classList.add('overflow-hidden');
        }
        return true;
      }

      openDrawerAfterDiscount() {
        try {
          if (sessionStorage.getItem('bb-open-drawer') !== '1') return;
          sessionStorage.removeItem('bb-open-drawer');
        } catch (e) {
          return;
        }
        // Full page reload after /discount — drawer HTML is fresh from Liquid
        requestAnimationFrame(() => this.openCartDrawer());
      }

      /* ---------- Swiper ---------- */
      initSwipers() {
        const S = window.Swiper;
        if (!S || this.swipersReady) return;
        this.swipersReady = true;

        // Tabs bar is draggable/swipeable. The arrows switch steps (tab + content), see setStep().
        this.tabsSwiper = new S(this.querySelector('[data-bb-tabs]'), {
          slidesPerView: 'auto',
          spaceBetween: 24,
          freeMode: true,
          watchOverflow: true,
          observer: true,
          observeParents: true,
          observeSlideChildren: true,
        });

        // Recalculate widths once web fonts are loaded (tab widths change)
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(() => this.tabsSwiper && this.tabsSwiper.update());
        }

        // Products: slider on mobile/tablet, disabled on desktop (CSS grid)
        this.sliders = [...this.querySelectorAll('[data-bb-slider]')].map(
          (el) =>
            new S(el, {
              slidesPerView: 2.15,
              spaceBetween: 12,
              watchOverflow: true,
              observer: true,
              observeParents: true,
              breakpoints: {
                750: { slidesPerView: 3.2, spaceBetween: 16 },
                990: { slidesPerView: 3, spaceBetween: 16, enabled: false },
              },
            })
        );
      }

      /* ---------- Events ---------- */
      bind() {
        this.addEventListener('click', (e) => {
          const el = e.target.closest('[data-action]');
          if (!el || !this.contains(el)) return;
          switch (el.dataset.action) {
            case 'tab':
              this.setStep(Number(el.dataset.index));
              break;
            case 'inc':
              this.change(el.closest('[data-card]'), 1);
              break;
            case 'dec':
              this.change(el.closest('[data-card]'), -1);
              break;
            case 'remove':
              this.removeOne(el.dataset.key);
              break;
            case 'group': {
              // Toggle the class only (no re-render) so the CSS transition can run
              const id = el.dataset.id;
              const isOpen = !this.open.has(id);
              if (isOpen) this.open.add(id);
              else this.open.delete(id);
              el.closest('.bb-group').classList.toggle('is-open', isOpen);
              el.setAttribute('aria-expanded', String(isOpen));
              break;
            }
            case 'step-prev':
              this.setStep(this.current - 1);
              break;
            case 'step-next':
              this.setStep(this.current + 1);
              break;
            case 'toggle': {
              const isOpen = this.sum.classList.toggle('is-open');
              el.setAttribute('aria-expanded', String(isOpen));
              break;
            }
            case 'zoom': {
              const card = el.closest('[data-card]');
              const dlg = this.querySelector('[data-zoom-dialog]');
              const img = this.querySelector('[data-zoom-img]');
              img.src = card.dataset.zoom;
              img.alt = card.dataset.title;
              dlg.showModal();
              break;
            }
            case 'close-zoom':
              this.querySelector('[data-zoom-dialog]').close();
              break;
            case 'add':
              this.addToCart(el);
              break;
          }
        });

        this.querySelector('[data-zoom-dialog]').addEventListener('click', (e) => {
          if (e.target === e.currentTarget) e.currentTarget.close();
        });

        this.addEventListener('change', (e) => {
          const sel = e.target.closest('[data-variant-select]');
          if (!sel) return;
          const card = sel.closest('[data-card]');
          if (!card) return;
          const step = card.dataset.step;
          const title = card.dataset.title;
          [...this.items.entries()].forEach(([key, item]) => {
            if (item.step === step && item.title === title) this.items.delete(key);
          });
          this.render();
        });
      }

      setStep(index) {
        if (index < 0 || index >= this.tabs.length) return;
        this.current = index;
        this.updateArrows();
        this.tabs.forEach((t, i) => {
          t.classList.toggle('is-active', i === index);
          t.setAttribute('aria-selected', String(i === index));
        });
        this.panels.forEach((p, i) => (p.hidden = i !== index));
        const step = this.cfg.steps[index];
        if (step) this.open.add(step.id);
        if (this.tabsSwiper) this.tabsSwiper.slideTo(index);
        requestAnimationFrame(() => this.sliders && this.sliders.forEach((s) => s.update()));
        this.render();
      }

      updateArrows() {
        const prev = this.querySelector('[data-action="step-prev"]');
        const next = this.querySelector('[data-action="step-next"]');
        if (prev) prev.disabled = this.current <= 0;
        if (next) next.disabled = this.current >= this.tabs.length - 1;
      }

      // Accordion structure is built once; render() only updates its content
      buildGroups() {
        this.querySelector('[data-groups]').innerHTML = this.cfg.steps
          .map((s) => `
            <div class="bb-group" data-group>
              <button type="button" class="bb-group__head" data-action="group" data-id="${esc(s.id)}" aria-expanded="false">
                <span class="bb-group__title">${esc(s.title)}</span>
                <span class="bb-group__count" data-group-count></span>
                <svg class="bb-group__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                <span class="bb-group__req">${esc(this.reqText(s))}</span>
              </button>
              <div class="bb-group__body">
                <div class="bb-group__inner">
                  <div class="bb-group__list" data-group-list></div>
                </div>
              </div>
            </div>`)
          .join('');
        const els = [...this.querySelectorAll('[data-group]')];
        this.groupEls = new Map(this.cfg.steps.map((s, i) => [s.id, els[i]]));
      }

      /* ---------- State ---------- */
      key(step, id) { return `${step}|${id}`; }

      variantOf(card) {
        const sel = card.querySelector('[data-variant-select]');
        if (sel) {
          const o = sel.selectedOptions[0];
          return {
            id: Number(o.value),
            price: Number(o.dataset.price),
            title: o.dataset.title,
            available: o.dataset.available === 'true',
            inventory: Number(o.dataset.inventory),
            inventoryPolicy: o.dataset.inventoryPolicy || '',
            inventoryManagement: o.dataset.inventoryManagement || '',
          };
        }
        return {
          id: Number(card.dataset.variantId),
          price: Number(card.dataset.price),
          title: '',
          available: card.dataset.available === 'true',
          inventory: Number(card.dataset.inventory),
          inventoryPolicy: card.dataset.inventoryPolicy || '',
          inventoryManagement: card.dataset.inventoryManagement || '',
        };
      }

      stepCount(stepId) {
        let n = 0;
        this.items.forEach((i) => { if (i.step === stepId) n += i.qty; });
        return n;
      }

      maxReached(stepId) {
        const s = this.cfg.steps.find((x) => x.id === stepId);
        return !!(s && s.max > 0 && this.stepCount(stepId) >= s.max);
      }

      stockLimit(v) {
        // No Shopify inventory tracking, or continue selling when OOS → no hard cap
        if (!v.inventoryManagement || v.inventoryPolicy === 'continue') return Infinity;
        const n = Number(v.inventory);
        return Number.isFinite(n) ? Math.max(0, n) : 0;
      }

      canIncrease(v, stepId, currentQty) {
        if (!v.available) return false;
        if (this.maxReached(stepId)) return false;
        return currentQty < this.stockLimit(v);
      }

      change(card, delta) {
        if (card.classList.contains('is-soldout') || card.dataset.productAvailable === 'false') return;
        const v = this.variantOf(card);
        const step = card.dataset.step;
        const k = this.key(step, v.id);
        const cur = this.items.get(k);
        const currentQty = cur ? cur.qty : 0;
        const beforeStepCount = this.stepCount(step);
        const qty = currentQty + delta;
        if (delta > 0 && !this.canIncrease(v, step, currentQty)) return;
        if (qty <= 0) this.items.delete(k);
        else this.items.set(k, { id: v.id, step, qty, price: v.price, title: card.dataset.title, variant: v.title, image: card.dataset.image });
        this.render();

        // Auto-advance when this step first becomes valid
        if (delta > 0) {
          const stepCfg = this.cfg.steps.find((x) => x.id === step);
          const afterStepCount = this.stepCount(step);
          if (stepCfg && beforeStepCount < stepCfg.min && afterStepCount >= stepCfg.min) {
            const idx = this.cfg.steps.findIndex((x) => x.id === step);
            if (idx > -1 && idx === this.current && idx < this.cfg.steps.length - 1) {
              this.setStep(idx + 1);
            }
          }
        }
      }

      removeOne(k) {
        const it = this.items.get(k);
        if (!it) return;
        it.qty -= 1;
        if (it.qty <= 0) this.items.delete(k);
        this.render();
      }

      /* ---------- Render ---------- */
      reqText(s) {
        const t = this.cfg.text;
        if (s.min === 0) return t.optional;
        if (s.max && s.max === s.min) return tpl(t.required, { count: s.min });
        return tpl(t.atLeast, { count: s.min });
      }

      render() {
        const t = this.cfg.text;
        const tiers = this.cfg.tiers;
        const list = [...this.items.values()];
        const total = list.reduce((a, i) => a + i.qty, 0);
        const sum = list.reduce((a, i) => a + i.qty * i.price, 0);

        // cards
        this.querySelectorAll('[data-card]').forEach((card) => {
          const soldOut = card.classList.contains('is-soldout') || card.dataset.productAvailable === 'false';
          const priceEl = card.querySelector('.bb-card__price');
          if (soldOut) {
            if (priceEl) priceEl.textContent = this.money.format(Number(card.dataset.price) / 100);
            const hint = card.querySelector('[data-stock-hint]');
            if (hint) hint.textContent = '';
            return;
          }
          const v = this.variantOf(card);
          const step = card.dataset.step;
          const qty = (this.items.get(this.key(step, v.id)) || {}).qty || 0;
          const canInc = this.canIncrease(v, step, qty);
          const qtyEl = card.querySelector('[data-qty]');
          const decBtn = card.querySelector('[data-action="dec"]');
          const incBtn = card.querySelector('[data-action="inc"]');
          if (qtyEl) qtyEl.textContent = qty;
          if (decBtn) decBtn.disabled = qty <= 0;
          if (incBtn) incBtn.disabled = !canInc;
          if (priceEl) priceEl.textContent = this.money.format(v.price / 100);
          const hint = card.querySelector('[data-stock-hint]');
          if (hint) {
            const limit = this.stockLimit(v);
            const atStockCap = v.available && Number.isFinite(limit) && limit !== Infinity && qty >= limit && !this.maxReached(step);
            hint.textContent = atStockCap
              ? tpl(t.stockLimit || 'Only {count} left in stock', { count: limit })
              : '';
          }
        });

        // progress
        const n = tiers.length;
        let fill = 0;
        if (n > 0 && total > 0) {
          const centers = tiers.map((_, i) => ((i * 2 + 1) / (n * 2)) * 100);
          if (total < tiers[0].qty) fill = (total / tiers[0].qty) * centers[0];
          else if (total >= tiers[n - 1].qty) fill = 100;
          else {
            for (let i = 0; i < n - 1; i++) {
              if (total < tiers[i + 1].qty) {
                fill = centers[i] + ((total - tiers[i].qty) / (tiers[i + 1].qty - tiers[i].qty)) * (centers[i + 1] - centers[i]);
                break;
              }
            }
          }
        }
        this.querySelector('.bb-progress__track')?.style.setProperty('--bb-fill', `${Math.max(0, Math.min(100, fill))}%`);
        this.querySelectorAll('[data-node]').forEach((node, i) => node.classList.toggle('is-reached', !!(tiers[i] && total >= tiers[i].qty)));

        // message
        const next = tiers.find((x) => total < x.qty);
        this.querySelector('[data-msg]').textContent = next
          ? tpl(t.addMore, { count: next.qty - total, percent: next.percent })
          : t.unlocked;

        // groups — update list HTML only when contents change
        this.cfg.steps.forEach((s) => {
          const g = this.groupEls && this.groupEls.get(s.id);
          if (!g) return;
          const rows = list.filter((i) => i.step === s.id);
          const count = rows.reduce((a, i) => a + i.qty, 0);
          const state = count < s.min ? 'is-warn' : count > 0 ? 'is-ok' : '';
          const isOpen = this.open.has(s.id);
          const sig = rows.map((i) => `${i.id}:${i.qty}:${i.variant || ''}`).join('|');

          g.classList.toggle('is-open', isOpen);
          g.querySelector('[data-action="group"]').setAttribute('aria-expanded', String(isOpen));

          const countEl = g.querySelector('[data-group-count]');
          countEl.textContent = tpl(t.added, { count });
          countEl.className = ('bb-group__count ' + state).trim();

          if (g.dataset.sig !== sig) {
            g.dataset.sig = sig;
            g.querySelector('[data-group-list]').innerHTML = rows
              .map((i) => `
                <div class="bb-item">
                  <div class="bb-item__media">
                    <img src="${esc(i.image)}" alt="">
                    <button type="button" class="bb-item__remove" data-action="remove" data-key="${esc(this.key(i.step, i.id))}" aria-label="Remove one ${esc(i.title)}">&minus;</button>
                    <span class="bb-item__qty">${i.qty}</span>
                  </div>
                  <div class="bb-item__info">
                    <p>${esc(i.title)}</p>
                    ${i.variant ? `<p>${esc(i.variant)}</p>` : ''}
                    <p class="bb-item__price">${this.money.format(i.price / 100)}</p>
                  </div>
                </div>`)
              .join('');
          }
        });

        // total — show discounted price only when tier has a real discount code
        const reached = tiers.filter((x) => total >= x.qty);
        const tier = reached[reached.length - 1];
        const canDiscount = !!(tier && tier.code);
        const discounted = canDiscount ? Math.round((sum * (100 - tier.percent)) / 100) : sum;
        this.querySelector('[data-total]').innerHTML = canDiscount
          ? `<s>${this.money.format(sum / 100)}</s><strong>${this.money.format(discounted / 100)}</strong>`
          : `<strong>${this.money.format(sum / 100)}</strong>`;

        // button
        const addBtn = this.querySelector('[data-action="add"]');
        if (addBtn && !addBtn.classList.contains('is-loading')) {
          const valid = total > 0 && this.cfg.steps.every((s) => this.stepCount(s.id) >= s.min);
          addBtn.disabled = !valid;
        }
        this.querySelector('[data-error]').textContent = '';
      }

      /* ---------- Cart ---------- */
      async addToCart(btn) {
        const total = [...this.items.values()].reduce((a, i) => a + i.qty, 0);
        const tiers = this.cfg.tiers.filter((x) => total >= x.qty);
        const tier = tiers[tiers.length - 1];
        const bundleId = 'bundle-' + Date.now().toString(36);

        const items = [...this.items.values()].map((i) => ({
          id: i.id,
          quantity: i.qty,
          properties: {
            _bundle_id: bundleId,
            _bundle_discount: tier ? String(tier.percent) : '0',
          },
        }));

        const cart = document.querySelector('cart-drawer');
        const body = { items };
        if (cart && typeof cart.getSectionsToRender === 'function') {
          body.sections = cart.getSectionsToRender().map((s) => s.id);
          body.sections_url = window.location.pathname;
        }

        btn.classList.add('is-loading');
        btn.disabled = true;

        try {
          const res = await fetch((window.routes && window.routes.cart_add_url ? window.routes.cart_add_url : '/cart/add') + '.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(body),
          });
          const data = await res.json();
          if (!res.ok || data.status) throw new Error(data.description || data.message || this.cfg.text.error);

          this.items.clear();

          // Apply discount code, then return here and open drawer (never /cart page)
          if (tier && tier.code) {
            try {
              sessionStorage.setItem('bb-open-drawer', '1');
            } catch (e) {}
            const back = window.location.pathname + window.location.search;
            window.location.href = '/discount/' + encodeURIComponent(tier.code) + '?redirect=' + encodeURIComponent(back);
            return;
          }

          if (!this.openCartDrawer(data)) {
            window.location.href = (window.routes && window.routes.cart_url) || '/cart';
            return;
          }
        } catch (err) {
          btn.classList.remove('is-loading');
          this.render();
          this.querySelector('[data-error]').textContent = err.message || this.cfg.text.error;
          return;
        }
        btn.classList.remove('is-loading');
        this.render();
      }
    }

    customElements.define('bundle-builder', BundleBuilder);
  })();
</script>

{% schema %}
{
  "name": "Bundle builder",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading_accent", "label": "Italic part", "default": "Unbeatable prices" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "with bundle." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Create your personalized skincare ritual and unlock exclusive savings." },

    { "type": "header", "content": "Texts" },
    { "type": "text", "id": "summary_title", "label": "Summary title", "default": "Bundle Contents" },
    { "type": "text", "id": "text_add_more", "label": "Add more message", "default": "Add {count} more to get {percent}% off.", "info": "Use {count} and {percent}." },
    { "type": "text", "id": "text_unlocked", "label": "All unlocked message", "default": "Congratulations! You’ve unlocked all rewards in your bundle!" },
    { "type": "text", "id": "text_required", "label": "Required label", "default": "{count} item(s) required" },
    { "type": "text", "id": "text_at_least", "label": "At least label", "default": "At least {count} item(s)" },
    { "type": "text", "id": "text_optional", "label": "Optional label", "default": "Optional" },
    { "type": "text", "id": "text_added", "label": "Added label", "default": "{count} item(s) added" },
    { "type": "text", "id": "text_total", "label": "Total label", "default": "Total" },
    { "type": "text", "id": "text_button", "label": "Button label", "default": "Add all to cart" },
    { "type": "text", "id": "text_error", "label": "Error message", "default": "Could not add the bundle to the cart. Please try again." },
    { "type": "text", "id": "text_sold_out", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "text_stock_limit", "label": "Stock limit message", "default": "Only {count} left in stock", "info": "Use {count}." },

    { "type": "header", "content": "Colors & spacing" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1f3a7d" },
    { "type": "color", "id": "ok_color", "label": "Requirement met", "default": "#7a9a3a" },
    { "type": "color", "id": "warn_color", "label": "Requirement missing", "default": "#d9573b" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step (tab)",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "Prep Your Skin" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sun", "label": "Sun" },
            { "value": "moon", "label": "Moon" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "drop", "label": "Drop" }
          ],
          "default": "sun"
        },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 24 },
        { "type": "range", "id": "min_items", "label": "Minimum items (0 = optional)", "min": 0, "max": 10, "step": 1, "default": 1 },
        { "type": "range", "id": "max_items", "label": "Maximum items (0 = unlimited)", "min": 0, "max": 20, "step": 1, "default": 0, "info": "If max equals min, the label shows \"N item(s) required\"." }
      ]
    },
    {
      "type": "tier",
      "name": "Discount tier",
      "settings": [
        { "type": "range", "id": "qty", "label": "Items needed", "min": 1, "max": 20, "step": 1, "default": 3 },
        { "type": "range", "id": "percent", "label": "% off", "min": 1, "max": 90, "step": 1, "default": 5 },
        {
          "type": "text",
          "id": "code",
          "label": "Discount code",
          "info": "Required to apply the discount in cart (via /discount/CODE). Without a code, the summary shows full price only."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle builder",
      "blocks": [
        { "type": "step", "settings": { "title": "Prep Your Skin", "icon": "sun", "min_items": 1 } },
        { "type": "step", "settings": { "title": "Treat & Nourish", "icon": "moon", "min_items": 1 } },
        { "type": "step", "settings": { "title": "Lock the Glow", "icon": "sparkle", "min_items": 1 } },
        { "type": "tier", "settings": { "qty": 3, "percent": 5 } },
        { "type": "tier", "settings": { "qty": 5, "percent": 10 } },
        { "type": "tier", "settings": { "qty": 7, "percent": 15 } }
      ]
    }
  ]
}
{% endschema %}