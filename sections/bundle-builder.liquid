    { "type": "range", "id": "tier_3_qty", "label": "Tier 3: items", "min": 1, "max": 20, "step": 1, "default": 7 },
    { "type": "range", "id": "tier_3_percent", "label": "Tier 3: % off", "min": 1, "max": 90, "step": 1, "default": 15 },
