{%- comment -%}
  sections/bundle-builder.liquid
  Bundle builder для Dawn. Потребує Swiper (CSS + JS), які вже підключені в темі (глобальний `window.Swiper`).
{%- endcomment -%}

<style>
  .bb {
    --bb-accent: {{ section.settings.accent_color }};
    --bb-ok: {{ section.settings.ok_color }};
    --bb-warn: {{ section.settings.warn_color }};
    --bb-border: #d4d7e2;
    --bb-muted: #6b7280;
    --bb-surface: #e5e8ee;
    --bb-accent-font: 'Playfair Display', Georgia, 'Times New Roman', serif;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    color: #1b1f2a;
  }
  .bb *, .bb *::before, .bb *::after { box-sizing: border-box; }
  .bb button { font: inherit; }

  /* ---------- Heading ---------- */
  .bb__head { text-align: center; margin-bottom: 28px; }
  .bb__title { font-size: clamp(26px, 3vw, 34px); font-weight: 500; margin: 0 0 12px; line-height: 1.2; }
  .bb__title em { font-family: var(--bb-accent-font); font-style: italic; font-weight: 400; color: var(--bb-accent); }
  .bb__sub { margin: 0 auto; max-width: 520px; font-size: 14px; color: var(--bb-muted); }

  /* ---------- Layout ---------- */
  .bb__layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; align-items: start; }
  .bb__main { min-width: 0; }
  @media (min-width: 990px) {
    .bb__layout { grid-template-columns: minmax(0, 1fr) 300px; gap: 16px; }
  }

  /* ---------- Tabs ---------- */
  .bb-tabs { display: flex; align-items: center; gap: 12px; background: #fff; border-radius: 12px; box-shadow: 0 1px 10px rgba(20, 30, 60, .09); padding: 10px 12px; margin-bottom: 20px; }
  .bb-tabs__swiper { flex: 1; min-width: 0; overflow: hidden; }
  .bb-tabs__slide { width: auto; }
  .bb-tab { display: inline-flex; align-items: center; gap: 10px; border: 0; background: none; padding: 0; cursor: pointer; color: var(--bb-muted); white-space: nowrap; font-size: 14px; }
  .bb-tab__icon { width: 32px; height: 32px; border-radius: 50%; border: 1px solid #c4c9d6; background: #fff; color: #8a90a0; display: grid; place-items: center; flex: none; transition: background .2s, color .2s, border-color .2s; }
  .bb-tab__icon svg { width: 17px; height: 17px; }
  .bb-tab.is-active { color: #111; }
  .bb-tab.is-active .bb-tab__icon { background: var(--bb-accent); border-color: var(--bb-accent); color: #fff; }
  .bb-tab:focus-visible, .bb-btn:focus-visible, .bb-qty button:focus-visible { outline: 2px solid var(--bb-accent); outline-offset: 2px; }
  .bb-tabs__nav { display: none; gap: 8px; flex: none; }
  .bb-tabs__arrow { width: 30px; height: 30px; border-radius: 50%; border: 0; background: #c9ccd6; color: #fff; display: grid; place-items: center; cursor: pointer; padding: 0; }
  .bb-tabs__arrow svg { width: 14px; height: 14px; }
  .bb-tabs__arrow.swiper-button-disabled { background: #eceef3; color: #b5b9c6; pointer-events: none; }
  @media (min-width: 750px) { .bb-tabs__nav { display: flex; } }

  /* ---------- Products ---------- */
  .bb-panel[hidden] { display: none !important; }
  .bb-slider { overflow: hidden; }
  .bb-slider .swiper-slide { height: auto; }
  .bb-card__media { position: relative; display: block; aspect-ratio: 1 / 1; background: var(--bb-surface); border-radius: 10px; overflow: hidden; }
  .bb-card__media img { width: 100%; height: 100%; object-fit: contain; padding: 12%; mix-blend-mode: multiply; }
  .bb-card__zoom { position: absolute; right: 8px; bottom: 8px; width: 34px; height: 34px; border-radius: 50%; border: 0; background: var(--bb-accent); color: #fff; display: grid; place-items: center; padding: 0; cursor: pointer; }
  .bb-card__zoom svg { width: 17px; height: 17px; }
  .bb-card__body { text-align: center; padding-top: 16px; }
  .bb-card__title { font-size: 13px; font-weight: 500; margin: 0 0 6px; line-height: 1.35; }
  .bb-card__price { font-size: 13px; color: var(--bb-muted); margin: 0; }
  .bb-card__variant { margin: 8px auto 0; max-width: 100%; font-size: 12px; border: 1px solid var(--bb-border); border-radius: 8px; padding: 4px 8px; background: #fff; }
  .bb-qty { display: grid; grid-template-columns: 40px 1fr 40px; align-items: center; height: 40px; margin: 14px 4px 0; border: 2px solid #cdd1dc; border-radius: 999px; background: #fff; }
  .bb-qty button { height: 100%; border: 0; background: none; cursor: pointer; font-size: 18px; line-height: 1; color: #555b6b; padding: 0; }
  .bb-qty button:disabled { opacity: .35; cursor: not-allowed; }
  .bb-qty span { text-align: center; font-size: 13px; }
  .bb-empty { padding: 32px 0; text-align: center; color: var(--bb-muted); }

  @media (min-width: 990px) {
    /* десктоп: сітка 3 колонки замість слайдера */
    .bb-slider .swiper-wrapper { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 16px; transform: none !important; height: auto !important; }
    .bb-slider .swiper-slide { width: auto !important; margin: 0 !important; }
    .bb-card__zoom { display: none; }
  }

  /* ---------- Summary ---------- */
  .bb-sum { background: #fff; border: 1.5px solid var(--bb-border); border-radius: 16px; padding: 20px 22px; }
  .bb-sum__title { margin: 0; font-size: 15px; font-weight: 500; }
  .bb-sum__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 12px; }
  .bb-sum__msg { margin: 0; font-size: 13px; color: #4b5160; line-height: 1.4; }
  .bb-sum__toggle { display: none; flex: none; width: 28px; height: 28px; padding: 0; border: 0; background: none; cursor: pointer; color: #1b1f2a; }
  .bb-sum__toggle svg { width: 24px; height: 24px; transition: transform .2s; }
  .bb-sum.is-open .bb-sum__toggle svg { transform: rotate(45deg); }

  .bb-progress { position: relative; margin: 14px 0 0; padding-bottom: 24px; }
  .bb-progress__track { position: relative; height: 4px; border-radius: 4px; background: #d3d7e2; }
  .bb-progress__fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 4px; background: var(--bb-accent); transition: width .35s ease; }
  .bb-node { position: absolute; top: 50%; width: 18px; height: 18px; border-radius: 50%; transform: translate(-50%, -50%); background: #fff; border: 2px solid #d3d7e2; display: grid; place-items: center; color: #fff; transition: background .25s, border-color .25s; }
  .bb-node svg { width: 10px; height: 10px; opacity: 0; }
  .bb-node.is-reached { background: var(--bb-accent); border-color: var(--bb-accent); }
  .bb-node.is-reached svg { opacity: 1; }
  .bb-node__label { position: absolute; top: 24px; left: 50%; transform: translateX(-50%); font-size: 12px; color: var(--bb-muted); white-space: nowrap; }

  .bb-sum__contents { display: none; margin-top: 4px; }
  .bb-group { border: 1px solid var(--bb-border); border-radius: 8px; margin-top: 12px; overflow: hidden; }
  .bb-group.is-open { border-color: #c2c8d8; }
  .bb-group__head { width: 100%; display: grid; grid-template-columns: 1fr auto 16px; grid-template-areas: 'title count chev' 'req req req'; column-gap: 8px; align-items: center; text-align: left; border: 0; background: none; padding: 10px 12px; cursor: pointer; }
  .bb-group.is-open .bb-group__head { background: #e6e9f0; }
  .bb-group__title { grid-area: title; font-size: 12px; color: #3a4050; }
  .bb-group__count { grid-area: count; font-size: 12px; color: var(--bb-muted); }
  .bb-group__count.is-ok { color: var(--bb-ok); }
  .bb-group__count.is-warn { color: var(--bb-warn); }
  .bb-group__chev { grid-area: chev; width: 14px; height: 14px; color: #6b7280; transition: transform .2s; }
  .bb-group.is-open .bb-group__chev { transform: rotate(180deg); }
  .bb-group__req { grid-area: req; font-size: 10px; color: var(--bb-muted); font-style: italic; margin-top: 2px; }
  .bb-group__body { display: none; padding: 12px; }
  .bb-group.is-open .bb-group__body { display: block; }
  .bb-group__body:empty { padding: 0; }

  .bb-item { display: flex; align-items: center; gap: 14px; }
  .bb-item + .bb-item { margin-top: 12px; }
  .bb-item__media { position: relative; width: 52px; height: 52px; flex: none; border-radius: 6px; background: var(--bb-surface); }
  .bb-item__media img { width: 100%; height: 100%; object-fit: contain; padding: 6px; border-radius: 6px; mix-blend-mode: multiply; }
  .bb-item__remove { position: absolute; top: -6px; left: -6px; width: 18px; height: 18px; border-radius: 50%; border: 1px solid #aab0c0; background: #fff; color: #555b6b; font-size: 13px; line-height: 1; padding: 0; cursor: pointer; display: grid; place-items: center; }
  .bb-item__qty { position: absolute; bottom: -6px; left: -6px; min-width: 18px; height: 18px; padding: 0 4px; border-radius: 9px; background: var(--bb-accent); color: #fff; font-size: 10px; display: grid; place-items: center; }
  .bb-item__info p { margin: 0; font-size: 12px; line-height: 1.4; color: #3a4050; }
  .bb-item__info .bb-item__price { color: var(--bb-muted); margin-top: 2px; }

  .bb-sum__total { display: flex; align-items: baseline; justify-content: space-between; margin: 18px 0 14px; font-size: 13px; color: var(--bb-muted); }
  .bb-sum__total strong { font-size: 15px; color: #1b1f2a; font-weight: 600; }
  .bb-sum__total s { margin-right: 8px; font-weight: 400; color: var(--bb-muted); font-size: 13px; }
  .bb-btn { width: 100%; height: 44px; border: 0; border-radius: 10px; background: var(--bb-accent); color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; transition: opacity .2s; }
  .bb-btn:disabled { opacity: .55; cursor: not-allowed; }
  .bb-btn.is-loading { opacity: .7; pointer-events: none; }
  .bb-sum__error { margin: 10px 0 0; font-size: 12px; color: var(--bb-warn); }
  .bb-sum__error:empty { display: none; }

  @media (min-width: 990px) {
    .bb-sum { position: sticky; top: 20px; }
    .bb-sum__contents { display: block; }
  }

  /* ---------- Mobile: sticky bundle, продукти скролляться під ним ---------- */
  @media (max-width: 989px) {
    .bb-sum {
      position: sticky;
      bottom: 0;
      z-index: 20;
      background: #fff; /* непрозорий фон, щоб блок з продуктами ховався під ним */
      padding: 14px 16px calc(14px + env(safe-area-inset-bottom, 0px));
      box-shadow: 0 -10px 24px rgba(20, 30, 60, .14);
    }
    .bb-sum__toggle { display: block; }
    .bb-sum.is-open .bb-sum__contents { display: block; max-height: 32vh; overflow-y: auto; overscroll-behavior: contain; }
    .bb-sum__total { margin: 12px 0 10px; }
    .bb-progress { margin-top: 10px; }
  }

  /* ---------- Zoom ---------- */
  .bb-zoom { border: 0; padding: 0; border-radius: 12px; width: min(92vw, 560px); background: #fff; }
  .bb-zoom::backdrop { background: rgba(10, 14, 30, .6); }
  .bb-zoom img { display: block; width: 100%; height: auto; }
  .bb-zoom__close { position: absolute; top: 8px; right: 8px; width: 34px; height: 34px; border-radius: 50%; border: 0; background: rgba(255, 255, 255, .9); font-size: 20px; line-height: 1; cursor: pointer; }

  @media (prefers-reduced-motion: reduce) {
    .bb-progress__fill, .bb-node, .bb-sum__toggle svg, .bb-group__chev { transition: none; }
  }
</style>

<bundle-builder class="bb" data-section-id="{{ section.id }}">
  <script type="application/json" data-bb-config>
    {
      "currency": {{ cart.currency.iso_code | json }},
      "locale": {{ request.locale.iso_code | json }},
      "tiers": [
        { "qty": {{ section.settings.tier_1_qty }}, "percent": {{ section.settings.tier_1_percent }}, "code": {{ section.settings.tier_1_code | json }} },
        { "qty": {{ section.settings.tier_2_qty }}, "percent": {{ section.settings.tier_2_percent }}, "code": {{ section.settings.tier_2_code | json }} },
        { "qty": {{ section.settings.tier_3_qty }}, "percent": {{ section.settings.tier_3_percent }}, "code": {{ section.settings.tier_3_code | json }} }
      ],
      "steps": [
        {%- for block in section.blocks -%}
          { "id": {{ block.id | json }}, "title": {{ block.settings.title | json }}, "min": {{ block.settings.min_items }}, "max": {{ block.settings.max_items }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "text": {
        "addMore": {{ section.settings.text_add_more | json }},
        "unlocked": {{ section.settings.text_unlocked | json }},
        "required": {{ section.settings.text_required | json }},
        "atLeast": {{ section.settings.text_at_least | json }},
        "optional": {{ section.settings.text_optional | json }},
        "added": {{ section.settings.text_added | json }},
        "error": {{ section.settings.text_error | json }}
      }
    }
  </script>

  <div class="page-width">
    <div class="bb__head">
      <h2 class="bb__title">
        {%- if section.settings.heading_accent != blank -%}<em>{{ section.settings.heading_accent }}</em>{%- endif %}
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="bb__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="bb__layout">
      <div class="bb__main">

        {%- comment -%} TABS (swiper) {%- endcomment -%}
        <div class="bb-tabs">
          <div class="swiper bb-tabs__swiper" data-bb-tabs>
            <div class="swiper-wrapper" role="tablist">
              {%- for block in section.blocks -%}
                <div class="swiper-slide bb-tabs__slide" {{ block.shopify_attributes }}>
                  <button type="button" role="tab" class="bb-tab{% if forloop.first %} is-active{% endif %}" data-action="tab" data-index="{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                    <span class="bb-tab__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        {%- case block.settings.icon -%}
                          {%- when 'moon' -%}<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
                          {%- when 'sparkle' -%}<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 17v4M17 19h4"/>
                          {%- when 'drop' -%}<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>
                          {%- else -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
                        {%- endcase -%}
                      </svg>
                    </span>
                    {{ block.settings.title }}
                  </button>
                </div>
              {%- endfor -%}
            </div>
          </div>
          <div class="bb-tabs__nav">
            <button type="button" class="bb-tabs__arrow" data-bb-tabs-prev aria-label="Previous">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
            </button>
            <button type="button" class="bb-tabs__arrow" data-bb-tabs-next aria-label="Next">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>

        {%- comment -%} PANELS (по одній на крок) {%- endcomment -%}
        {%- for block in section.blocks -%}
          <div class="bb-panel" role="tabpanel" data-panel="{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
            {%- assign coll = block.settings.collection -%}
            {%- if coll == blank or coll.products_count == 0 -%}
              <p class="bb-empty">Select a collection with products for this step.</p>
            {%- else -%}
              <div class="swiper bb-slider" data-bb-slider>
                <div class="swiper-wrapper">
                  {%- for product in coll.products limit: block.settings.products_limit -%}
                    {%- assign variant = product.selected_or_first_available_variant -%}
                    <div class="swiper-slide">
                      <div class="bb-card"
                        data-card
                        data-step="{{ block.id }}"
                        data-title="{{ product.title | escape }}"
                        data-image="{{ product.featured_image | image_url: width: 160 }}"
                        data-zoom="{{ product.featured_image | image_url: width: 1200 }}"
                        data-variant-id="{{ variant.id }}"
                        data-price="{{ variant.price }}"
                        data-available="{{ variant.available }}">
                        <div class="bb-card__media">
                          {%- if product.featured_image -%}
                            {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 45vw', alt: product.title }}
                          {%- endif -%}
                          <button type="button" class="bb-card__zoom" data-action="zoom" aria-label="Zoom {{ product.title | escape }}">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2M11 8.5v5M8.5 11h5"/></svg>
                          </button>
                        </div>
                        <div class="bb-card__body">
                          <h3 class="bb-card__title">{{ product.title }}</h3>
                          <p class="bb-card__price">{{ variant.price | money }}</p>
                          {%- unless product.has_only_default_variant -%}
                            <select class="bb-card__variant" data-variant-select aria-label="Variant">
                              {%- for v in product.variants -%}
                                <option value="{{ v.id }}" data-price="{{ v.price }}" data-title="{{ v.title | escape }}" data-available="{{ v.available }}" {% unless v.available %}disabled{% endunless %} {% if v.id == variant.id %}selected{% endif %}>{{ v.title }}</option>
                              {%- endfor -%}
                            </select>
                          {%- endunless -%}
                        </div>
                        <div class="bb-qty">
                          <button type="button" data-action="dec" aria-label="Decrease quantity" disabled>&minus;</button>
                          <span data-qty aria-live="polite">0</span>
                          <button type="button" data-action="inc" aria-label="Increase quantity">+</button>
                        </div>
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} BUNDLE CONTENTS {%- endcomment -%}
      <aside class="bb-sum" data-sum aria-label="Bundle Contents">
        <h3 class="bb-sum__title">{{ section.settings.summary_title }}</h3>
        <div class="bb-sum__row">
          <p class="bb-sum__msg" data-msg aria-live="polite"></p>
          <button type="button" class="bb-sum__toggle" data-action="toggle" aria-expanded="false" aria-label="Toggle bundle contents">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M12 4v16M4 12h16"/></svg>
          </button>
        </div>

        <div class="bb-progress">
          <div class="bb-progress__track">
            <div class="bb-progress__fill" data-fill></div>
            {%- for i in (1..3) -%}
              {%- liquid
                assign pos = forloop.index0 | times: 2 | plus: 1 | times: 16.6667
                case i
                  when 1
                    assign pct = section.settings.tier_1_percent
                  when 2
                    assign pct = section.settings.tier_2_percent
                  else
                    assign pct = section.settings.tier_3_percent
                endcase
              -%}
              <span class="bb-node" data-node style="left: {{ pos }}%">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
                <span class="bb-node__label">{{ pct }}% off</span>
              </span>
            {%- endfor -%}
          </div>
        </div>

        <div class="bb-sum__contents" data-groups></div>

        <div class="bb-sum__total">
          <span>{{ section.settings.text_total }}</span>
          <span data-total><strong>{{ 0 | money }}</strong></span>
        </div>
        <button type="button" class="bb-btn" data-action="add" disabled>{{ section.settings.text_button }}</button>
        <p class="bb-sum__error" data-error role="alert"></p>
      </aside>
    </div>
  </div>

  <dialog class="bb-zoom" data-zoom-dialog>
    <button type="button" class="bb-zoom__close" data-action="close-zoom" aria-label="Close">&times;</button>
    <img alt="" data-zoom-img>
  </dialog>
</bundle-builder>

<script>
  (() => {
    if (customElements.get('bundle-builder')) return;

    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const tpl = (str, vars) => String(str).replace(/\{(\w+)\}/g, (_, k) => (vars[k] ?? ''));

    class BundleBuilder extends HTMLElement {
      connectedCallback() {
        if (this.ready) return;
        this.ready = true;

        this.cfg = JSON.parse(this.querySelector('[data-bb-config]').textContent);
        try {
          this.money = new Intl.NumberFormat(this.cfg.locale, { style: 'currency', currency: this.cfg.currency });
        } catch (e) {
          this.money = new Intl.NumberFormat(undefined, { style: 'currency', currency: this.cfg.currency });
        }

        this.items = new Map(); // key: `${stepId}|${variantId}`
        this.open = new Set(this.cfg.steps.length ? [this.cfg.steps[0].id] : []);
        this.sum = this.querySelector('[data-sum]');
        this.tabs = [...this.querySelectorAll('[data-action="tab"]')];
        this.panels = [...this.querySelectorAll('[data-panel]')];

        this.bind();
        this.render();

        if (window.Swiper) this.initSwipers();
        else if (document.readyState === 'complete') console.warn('[bundle-builder] window.Swiper not found');
        else window.addEventListener('load', () => this.initSwipers(), { once: true });
      }

      /* ---------- Swiper ---------- */
      initSwipers() {
        const S = window.Swiper;
        if (!S || this.swipersReady) return;
        this.swipersReady = true;

        // Таби — свайпаються
        this.tabsSwiper = new S(this.querySelector('[data-bb-tabs]'), {
          slidesPerView: 'auto',
          spaceBetween: 24,
          freeMode: true,
          watchOverflow: true,
          navigation: {
            prevEl: this.querySelector('[data-bb-tabs-prev]'),
            nextEl: this.querySelector('[data-bb-tabs-next]'),
          },
        });

        // Продукти — слайдер на моб/планшеті, на десктопі вимкнений (CSS-сітка)
        this.sliders = [...this.querySelectorAll('[data-bb-slider]')].map(
          (el) =>
            new S(el, {
              slidesPerView: 2.15,
              spaceBetween: 12,
              watchOverflow: true,
              observer: true,
              observeParents: true,
              breakpoints: {
                750: { slidesPerView: 3.2, spaceBetween: 16 },
                990: { slidesPerView: 3, spaceBetween: 16, enabled: false },
              },
            })
        );
      }

      /* ---------- Events ---------- */
      bind() {
        this.addEventListener('click', (e) => {
          const el = e.target.closest('[data-action]');
          if (!el || !this.contains(el)) return;
          switch (el.dataset.action) {
            case 'tab':
              this.setStep(Number(el.dataset.index));
              break;
            case 'inc':
              this.change(el.closest('[data-card]'), 1);
              break;
            case 'dec':
              this.change(el.closest('[data-card]'), -1);
              break;
            case 'remove':
              this.removeOne(el.dataset.key);
              break;
            case 'group': {
              const id = el.dataset.id;
              this.open.has(id) ? this.open.delete(id) : this.open.add(id);
              this.render();
              break;
            }
            case 'toggle': {
              const isOpen = this.sum.classList.toggle('is-open');
              el.setAttribute('aria-expanded', String(isOpen));
              break;
            }
            case 'zoom': {
              const card = el.closest('[data-card]');
              const dlg = this.querySelector('[data-zoom-dialog]');
              const img = this.querySelector('[data-zoom-img]');
              img.src = card.dataset.zoom;
              img.alt = card.dataset.title;
              dlg.showModal();
              break;
            }
            case 'close-zoom':
              this.querySelector('[data-zoom-dialog]').close();
              break;
            case 'add':
              this.addToCart(el);
              break;
          }
        });

        this.querySelector('[data-zoom-dialog]').addEventListener('click', (e) => {
          if (e.target === e.currentTarget) e.currentTarget.close();
        });

        this.addEventListener('change', (e) => {
          if (e.target.closest('[data-variant-select]')) this.render();
        });
      }

      setStep(index) {
        this.tabs.forEach((t, i) => {
          t.classList.toggle('is-active', i === index);
          t.setAttribute('aria-selected', String(i === index));
        });
        this.panels.forEach((p, i) => (p.hidden = i !== index));
        const step = this.cfg.steps[index];
        if (step) this.open.add(step.id);
        if (this.tabsSwiper) this.tabsSwiper.slideTo(index);
        requestAnimationFrame(() => this.sliders && this.sliders.forEach((s) => s.update()));
        this.render();
      }

      /* ---------- State ---------- */
      key(step, id) { return `${step}|${id}`; }

      variantOf(card) {
        const sel = card.querySelector('[data-variant-select]');
        if (sel) {
          const o = sel.selectedOptions[0];
          return { id: Number(o.value), price: Number(o.dataset.price), title: o.dataset.title, available: o.dataset.available === 'true' };
        }
        return { id: Number(card.dataset.variantId), price: Number(card.dataset.price), title: '', available: card.dataset.available === 'true' };
      }

      stepCount(stepId) {
        let n = 0;
        this.items.forEach((i) => { if (i.step === stepId) n += i.qty; });
        return n;
      }

      maxReached(stepId) {
        const s = this.cfg.steps.find((x) => x.id === stepId);
        return !!(s && s.max > 0 && this.stepCount(stepId) >= s.max);
      }

      change(card, delta) {
        const v = this.variantOf(card);
        const step = card.dataset.step;
        const k = this.key(step, v.id);
        const cur = this.items.get(k);
        const qty = (cur ? cur.qty : 0) + delta;
        if (delta > 0 && (!v.available || this.maxReached(step))) return;
        if (qty <= 0) this.items.delete(k);
        else this.items.set(k, { id: v.id, step, qty, price: v.price, title: card.dataset.title, variant: v.title, image: card.dataset.image });
        this.render();
      }

      removeOne(k) {
        const it = this.items.get(k);
        if (!it) return;
        it.qty -= 1;
        if (it.qty <= 0) this.items.delete(k);
        this.render();
      }

      /* ---------- Render ---------- */
      reqText(s) {
        const t = this.cfg.text;
        if (s.min === 0) return t.optional;
        if (s.max && s.max === s.min) return tpl(t.required, { count: s.min });
        return tpl(t.atLeast, { count: s.min });
      }

      render() {
        const t = this.cfg.text;
        const tiers = this.cfg.tiers;
        const list = [...this.items.values()];
        const total = list.reduce((a, i) => a + i.qty, 0);
        const sum = list.reduce((a, i) => a + i.qty * i.price, 0);

        // cards
        this.querySelectorAll('[data-card]').forEach((card) => {
          const v = this.variantOf(card);
          const step = card.dataset.step;
          const qty = (this.items.get(this.key(step, v.id)) || {}).qty || 0;
          card.querySelector('[data-qty]').textContent = qty;
          card.querySelector('[data-action="dec"]').disabled = qty <= 0;
          card.querySelector('[data-action="inc"]').disabled = !v.available || this.maxReached(step);
          card.querySelector('.bb-card__price').textContent = this.money.format(v.price / 100);
        });

        // progress
        const n = tiers.length;
        const centers = tiers.map((_, i) => ((i * 2 + 1) / (n * 2)) * 100);
        let fill = 0;
        if (total > 0) {
          if (total < tiers[0].qty) fill = (total / tiers[0].qty) * centers[0];
          else if (total >= tiers[n - 1].qty) fill = 100;
          else {
            for (let i = 0; i < n - 1; i++) {
              if (total < tiers[i + 1].qty) {
                fill = centers[i] + ((total - tiers[i].qty) / (tiers[i + 1].qty - tiers[i].qty)) * (centers[i + 1] - centers[i]);
                break;
              }
            }
          }
        }
        this.querySelector('[data-fill]').style.width = fill + '%';
        this.querySelectorAll('[data-node]').forEach((node, i) => node.classList.toggle('is-reached', total >= tiers[i].qty));

        // message
        const next = tiers.find((x) => total < x.qty);
        this.querySelector('[data-msg]').textContent = next
          ? tpl(t.addMore, { count: next.qty - total, percent: next.percent })
          : t.unlocked;

        // groups
        this.querySelector('[data-groups]').innerHTML = this.cfg.steps
          .map((s) => {
            const rows = list.filter((i) => i.step === s.id);
            const count = rows.reduce((a, i) => a + i.qty, 0);
            const state = count < s.min ? 'is-warn' : count > 0 ? 'is-ok' : '';
            const isOpen = this.open.has(s.id);
            return `
              <div class="bb-group${isOpen ? ' is-open' : ''}">
                <button type="button" class="bb-group__head" data-action="group" data-id="${esc(s.id)}" aria-expanded="${isOpen}">
                  <span class="bb-group__title">${esc(s.title)}</span>
                  <span class="bb-group__count ${state}">${esc(tpl(t.added, { count }))}</span>
                  <svg class="bb-group__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                  <span class="bb-group__req">${esc(this.reqText(s))}</span>
                </button>
                <div class="bb-group__body">
                  ${rows
                    .map((i) => `
                    <div class="bb-item">
                      <div class="bb-item__media">
                        <img src="${esc(i.image)}" alt="">
                        <button type="button" class="bb-item__remove" data-action="remove" data-key="${esc(this.key(i.step, i.id))}" aria-label="Remove one ${esc(i.title)}">&minus;</button>
                        <span class="bb-item__qty">${i.qty}</span>
                      </div>
                      <div class="bb-item__info">
                        <p>${esc(i.title)}</p>
                        ${i.variant ? `<p>${esc(i.variant)}</p>` : ''}
                        <p class="bb-item__price">${this.money.format(i.price / 100)}</p>
                      </div>
                    </div>`)
                    .join('')}
                </div>
              </div>`;
          })
          .join('');

        // total
        const reached = tiers.filter((x) => total >= x.qty);
        const tier = reached[reached.length - 1];
        const discounted = tier ? Math.round((sum * (100 - tier.percent)) / 100) : sum;
        this.querySelector('[data-total]').innerHTML = tier
          ? `<s>${this.money.format(sum / 100)}</s><strong>${this.money.format(discounted / 100)}</strong>`
          : `<strong>${this.money.format(sum / 100)}</strong>`;

        // button
        const valid = total > 0 && this.cfg.steps.every((s) => this.stepCount(s.id) >= s.min);
        this.querySelector('[data-action="add"]').disabled = !valid;
        this.querySelector('[data-error]').textContent = '';
      }

      /* ---------- Cart ---------- */
      async addToCart(btn) {
        const total = [...this.items.values()].reduce((a, i) => a + i.qty, 0);
        const tiers = this.cfg.tiers.filter((x) => total >= x.qty);
        const tier = tiers[tiers.length - 1];
        const bundleId = 'bundle-' + Date.now().toString(36);

        const items = [...this.items.values()].map((i) => ({
          id: i.id,
          quantity: i.qty,
          properties: {
            _bundle_id: bundleId,
            _bundle_discount: tier ? String(tier.percent) : '0',
          },
        }));

        const cart = document.querySelector('cart-drawer');
        const body = { items };
        if (cart && typeof cart.getSectionsToRender === 'function') {
          body.sections = cart.getSectionsToRender().map((s) => s.id);
          body.sections_url = window.location.pathname;
        }

        btn.classList.add('is-loading');
        btn.disabled = true;

        try {
          const res = await fetch((window.routes && window.routes.cart_add_url ? window.routes.cart_add_url : '/cart/add') + '.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(body),
          });
          const data = await res.json();
          if (!res.ok || data.status) throw new Error(data.description || data.message || this.cfg.text.error);

          // Код знижки (опційно) — застосовується через /discount/CODE
          if (tier && tier.code) {
            window.location.href = '/discount/' + encodeURIComponent(tier.code) + '?redirect=' + encodeURIComponent('/cart');
            return;
          }

          if (cart && typeof cart.renderContents === 'function' && data.sections) {
            cart.renderContents(data);
            this.items.clear();
            this.render();
          } else {
            window.location.href = (window.routes && window.routes.cart_url) || '/cart';
          }
        } catch (err) {
          btn.classList.remove('is-loading');
          this.render();
          this.querySelector('[data-error]').textContent = err.message || this.cfg.text.error;
          return;
        }
        btn.classList.remove('is-loading');
        this.render();
      }
    }

    customElements.define('bundle-builder', BundleBuilder);
  })();
</script>

