{%- comment -%}
  ============================================================================
  Build Your Dream Cupcake — sections/sweets-builder.liquid
  ============================================================================
  An interactive sweets builder for the homepage.

  HOW IT WORKS
  1. The merchant uploads ONE base character image (section setting) and any
     number of option blocks: Sponge, Frosting, Topping, Extra.
  2. Every block = label + transparent layer image + related product.
  3. All layer images MUST share the same canvas size and aspect ratio as the
     base image (e.g. 900 x 1200 px transparent PNG), so they line up when
     stacked. Position the item on the canvas where it should appear.
  4. Liquid pre-renders every layer / card / product row once. JavaScript only
     toggles classes and attributes, so changes are instant (no network).

  FILE MAP
  - Liquid ........ top of file: data prep + markup
  - stylesheet block ..... all CSS, every selector scoped under `.sb`
  - javascript block .... <sweets-builder> custom element (one instance per section)
  - schema block ........ Theme Editor settings and blocks
{%- endcomment -%}

{%- liquid
  # --- Data prep ------------------------------------------------------------
  # Fixed category order = also the order of tabs and of the summary rows.
  assign categories = 'sponge,frosting,topping,extra' | split: ','

  # Tab labels come from section settings (merchant-editable), same order as above.
  assign tab_labels = section.settings.tab_sponge | append: '~~' | append: section.settings.tab_frosting | append: '~~' | append: section.settings.tab_topping | append: '~~' | append: section.settings.tab_extra
  assign tab_labels = tab_labels | split: '~~'

  # Base image + the aspect ratio used for the stage and the card thumbnails.
  assign base_image = section.settings.base_image
  assign base_ratio = base_image.aspect_ratio | default: 0.75

  # Alt text for the whole picture (the stage is exposed as ONE image to assistive tech).
  assign stage_label = section.settings.base_alt | default: section.settings.heading

  # The first category that actually has blocks becomes the initially open tab.
  assign first_category = ''
  for category in categories
    assign count = section.blocks | where: 'type', category | size
    if count > 0 and first_category == blank
      assign first_category = category
    endif
  endfor
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    <div class="page-width">

      {%- if section.blocks.size == 0 -%}
        {%- if request.design_mode -%}
          <p class="sb__notice">Add Sponge, Frosting, Topping or Extra blocks to start the sweets builder.</p>
        {%- endif -%}
      {%- else -%}

        {%- comment -%} The custom element is the JS scope: it only touches its own children. {%- endcomment -%}
        <sweets-builder
          class="sb"
          data-currency="{{ cart.currency.iso_code }}"
          id="SweetsBuilder-{{ section.id }}"
          style="--sb-ratio: {{ base_ratio }};"
        >
          <header class="sb__header">
            {%- if section.settings.heading != blank -%}
              <h2 class="sb__title">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
              <p class="sb__subtitle">{{ section.settings.subheading | escape }}</p>
            {%- endif -%}
          </header>

          <div class="sb__layout">

            {%- comment -%} ===== 1. STAGE: the cupcake preview ===== {%- endcomment -%}
            <div class="sb__stage-wrap">
              {%- comment -%}
                role="img" + aria-label: the stack of layers is announced as ONE image.
                JS updates the label with the current selection. All <img> inside use
                alt="" because they are purely decorative parts of this one picture.
              {%- endcomment -%}
              <div class="sb__stage" data-stage role="img" aria-label="{{ stage_label | escape }}" data-base-label="{{ stage_label | escape }}">
                <div class="sb__blob" aria-hidden="true"></div>

                <div class="sb__character">
                  {%- if base_image != blank -%}
                    <img
                      class="sb__base"
                      src="{{ base_image | image_url: width: 900 }}"
                      srcset="{{ base_image | image_url: width: 450 }} 450w, {{ base_image | image_url: width: 900 }} 900w, {{ base_image | image_url: width: 1350 }} 1350w"
                      sizes="(min-width: 990px) 560px, 90vw"
                      width="{{ base_image.width }}"
                      height="{{ base_image.height }}"
                      alt=""
                      loading="lazy"
                    >
                  {%- elsif request.design_mode -%}
                    {{ 'image' | placeholder_svg_tag: 'sb__placeholder' }}
                  {%- endif -%}

                  {%- comment -%}
                    One wrapper per category, one <img> per block. Only the image whose
                    block is selected gets `.is-active`. Stacking order is set in CSS.
                  {%- endcomment -%}
                  {%- for category in categories -%}
                    <div class="sb__layer" data-layer="{{ category }}" aria-hidden="true">
                      {%- for block in section.blocks -%}
                        {%- if block.type == category and block.settings.layer_image != blank -%}
                          {%- assign layer = block.settings.layer_image -%}
                          <img
                            class="sb__layer-img"
                            src="{{ layer | image_url: width: 900 }}"
                            srcset="{{ layer | image_url: width: 450 }} 450w, {{ layer | image_url: width: 900 }} 900w, {{ layer | image_url: width: 1350 }} 1350w"
                            sizes="(min-width: 990px) 560px, 90vw"
                            width="{{ layer.width }}"
                            height="{{ layer.height }}"
                            alt=""
                            loading="lazy"
                            data-layer-block="{{ block.id }}"
                          >
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endfor -%}
                </div>

                {%- comment -%} Celebration sparkles (purely decorative, animated by CSS) {%- endcomment -%}
                <div class="sb__sparks" aria-hidden="true">
                  {%- for i in (0..7) -%}
                    <span class="sb__spark" style="--a: {{ i | times: 45 }}deg; --i: {{ i }};"></span>
                  {%- endfor -%}
                </div>
              </div>

              {%- comment -%} Screen-reader announcements when the look changes {%- endcomment -%}
              <p class="sb__sr" data-live aria-live="polite" aria-atomic="true"></p>
            </div>

            {%- comment -%} ===== 2. CONTROLS: tabs + option cards + Surprise Me ===== {%- endcomment -%}
            <div class="sb__controls">
              <div class="sb__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
                {%- for category in categories -%}
                  {%- assign count = section.blocks | where: 'type', category | size -%}
                  {%- if count > 0 -%}
                    {%- assign is_first = false -%}
                    {%- if category == first_category %}{% assign is_first = true %}{% endif -%}
                    <button
                      type="button"
                      role="tab"
                      class="sb__tab"
                      id="SBTab-{{ section.id }}-{{ category }}"
                      data-category="{{ category }}"
                      aria-controls="SBPanel-{{ section.id }}-{{ category }}"
                      aria-selected="{{ is_first }}"
                      {% unless is_first %}tabindex="-1"{% endunless %}
                    >{{ tab_labels[forloop.index0] | escape }}</button>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- for category in categories -%}
                {%- assign count = section.blocks | where: 'type', category | size -%}
                {%- if count > 0 -%}
                  <div
                    class="sb__panel"
                    role="tabpanel"
                    id="SBPanel-{{ section.id }}-{{ category }}"
                    aria-labelledby="SBTab-{{ section.id }}-{{ category }}"
                    data-category="{{ category }}"
                    {% unless category == first_category %}hidden{% endunless %}
                  >
                    <ul class="sb__options" role="list">
                      {%- for block in section.blocks -%}
                        {%- if block.type == category -%}
                          {%- liquid
                            assign product = block.settings.product
                            assign option_label = block.settings.label | default: product.title | default: tab_labels[forloop.parentloop.index0]
                            assign thumb = block.settings.layer_image | default: product.featured_image
                          -%}
                          {%- comment -%} shopify_attributes lets the Theme Editor highlight/select this block {%- endcomment -%}
                          <li class="sb__option" {{ block.shopify_attributes }}>
                            {%- comment -%} Real <button> with aria-pressed: acts as a toggle (click again to remove) {%- endcomment -%}
                            <button
                              type="button"
                              class="sb__card"
                              data-option
                              data-category="{{ category }}"
                              data-block-id="{{ block.id }}"
                              data-label="{{ option_label | escape }}"
                              aria-pressed="false"
                            >
                              <span class="sb__thumb">
                                {%- if thumb != blank -%}
                                  <img
                                    class="sb__thumb-img"
                                    src="{{ thumb | image_url: width: 600 }}"
                                    width="{{ thumb.width }}"
                                    height="{{ thumb.height }}"
                                    alt=""
                                    loading="lazy"
                                  >
                                {%- endif -%}
                              </span>
                              <span class="sb__card-label">{{ option_label | escape }}</span>
                              <span class="sb__check" aria-hidden="true">
                                <svg viewBox="0 0 20 20" width="12" height="12" focusable="false"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                              </span>
                            </button>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              {%- endfor -%}

              {%- if section.settings.surprise_label != blank or section.settings.reset_label != blank -%}
                <div
                  class="sb__actions"
                  style="--sb-actions-gap: {{ section.settings.actions_gap }}px;"
                >
                  {%- if section.settings.surprise_label != blank -%}
                    <button type="button" class="sb__btn sb__btn--ghost sb__surprise" data-surprise>
                      <svg class="sb__dice" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="8.5" cy="8.5" r="1.4" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1.4" fill="currentColor"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/></svg>
                      {{ section.settings.surprise_label | escape }}
                    </button>
                  {%- endif -%}

                  {%- if section.settings.reset_label != blank -%}
                    <button type="button" class="sb__btn sb__btn--primary sb__reset" data-reset>
                      <svg class="sb__reset-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                        <path d="M4.5 12a7.5 7.5 0 0 1 12.7-5.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M17 3.5v4.2h-4.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M19.5 12a7.5 7.5 0 0 1-12.7 5.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M7 20.5v-4.2h4.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      {{ section.settings.reset_label | escape }}
                    </button>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

            {%- comment -%} ===== 3. SUMMARY: selected products + Shop the Look ===== {%- endcomment -%}
            <section class="sb__summary" aria-labelledby="SBSummary-{{ section.id }}">
              <h3 class="sb__summary-title" id="SBSummary-{{ section.id }}">{{ section.settings.summary_heading | escape }}</h3>
              <p class="sb__empty" data-empty>{{ section.settings.empty_text | escape }}</p>

              {%- comment -%}
                One hidden row per block that has a product. JS un-hides the rows of the
                selected blocks. Each row links to the product page.
              {%- endcomment -%}
              <ul class="sb__picks" role="list" data-picks>
                {%- for category in categories -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == category and block.settings.product != blank -%}
                      {%- assign product = block.settings.product -%}
                      <li class="sb__pick" data-pick-block="{{ block.id }}" data-price="{{ product.price }}" hidden>
                        <a class="sb__pick-link" href="{{ product.url }}">
                          {%- if product.featured_image != blank -%}
                            <img class="sb__pick-img" src="{{ product.featured_image | image_url: width: 160 }}" width="56" height="56" alt="" loading="lazy">
                          {%- endif -%}
                          <span class="sb__pick-text">
                            <span class="sb__pick-cat">{{ tab_labels[forloop.parentloop.index0] | escape }}</span>
                            <span class="sb__pick-name">{{ product.title | escape }}</span>
                            <span class="sb__pick-price">
                              {%- if product.price_varies -%}
                                {{ 'products.product.price.from_price_html' | t: price: product.price_min | money }}
                              {%- else -%}
                                {{ product.price | money }}
                              {%- endif -%}
                            </span>
                          </span>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
              </ul>

              {%- comment -%}
                Shop the Look: for now it links to the first selected product's page
                (in category order). Each row above also links to its own page.
                Later, swap this for an add-to-cart of all selected variants (see JS).
              {%- endcomment -%}
              {%- comment -%} Running total of the selected products (prices come from data-price, in minor units) {%- endcomment -%}
              {%- if section.settings.total_label != blank -%}
                <p class="sb__total" data-total hidden>
                  <span>{{ section.settings.total_label | escape }}</span>
                  <strong data-total-value></strong>
                </p>
              {%- endif -%}

              {%- comment -%}
                Shop the Look: links to the first selected product's page. When nothing is
                selected it uses the optional fallback link (e.g. a collection), or stays disabled.
              {%- endcomment -%}
              {%- if section.settings.cta_label != blank -%}
                {%- assign cta_fallback = section.settings.cta_link -%}
                <a
                  class="sb__btn sb__btn--primary sb__cta"
                  data-cta
                  data-fallback-href="{{ cta_fallback }}"
                  {% if cta_fallback != blank %}href="{{ cta_fallback }}"{% else %}aria-disabled="true"{% endif %}
                >{{ section.settings.cta_label | escape }}</a>
              {%- endif -%}
            </section>

          </div>
        </sweets-builder>
      {%- endif -%}

    </div>
  </div>
</div>

{% stylesheet %}
  /* =========================================================================
     STYLES — everything lives under `.sb` / `.sb__*`, so nothing leaks into
     other Dawn sections. Colors, fonts and radii reuse Dawn's CSS variables, so
     the section follows the store's color scheme automatically.
     Note: Dawn sets 1rem = 10px.
     ========================================================================= */

  .sb {
    /* Local design tokens: tweak here to restyle the whole section */
    --sb-accent: rgb(var(--color-button));
    --sb-on-accent: rgb(var(--color-button-text));
    --sb-line: rgba(var(--color-foreground), 0.12);
    --sb-soft: rgba(var(--color-foreground), 0.04);
    --sb-radius: 2rem;
    --sb-ease-pop: cubic-bezier(0.34, 1.56, 0.64, 1);
    display: block;
    color: rgb(var(--color-foreground));
  }

  .sb *,
  .sb *::before,
  .sb *::after { box-sizing: border-box; }

  .sb__notice {
    padding: 2rem;
    border: 0.1rem dashed rgba(var(--color-foreground), 0.4);
    border-radius: var(--sb-radius);
    text-align: center;
  }

  /* ---- Header ---- */
  .sb__header { max-width: 56rem; margin-bottom: 3rem; }
  .sb__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: clamp(2.8rem, 4vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .sb__subtitle { margin: 1rem 0 0; font-size: 1.7rem; line-height: 1.5; opacity: 0.75; }

  /* ---- Layout: mobile = stage, controls, summary (single column) ---- */
  .sb__layout {
    display: grid;
    gap: 2.4rem;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "stage" "controls" "summary";
  }
  .sb__stage-wrap { grid-area: stage; }
  .sb__controls   { grid-area: controls; min-width: 0; }
  .sb__summary    { grid-area: summary; min-width: 0; }

  /* Desktop: large stage on the left, summary right underneath it, options on the right */
  @media screen and (min-width: 990px) {
    .sb__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-areas: "stage controls" "summary controls";
      column-gap: 5rem;
      align-items: start;
    }
  }

  /* ---- Stage ---- */
  .sb__stage {
    position: relative;
    width: min(100%, 38rem);
    margin-inline: auto;
    aspect-ratio: var(--sb-ratio);
    border-radius: calc(var(--sb-radius) + 0.8rem);
    background: var(--sb-soft);
    overflow: hidden;
    isolation: isolate;
  }
  @media screen and (min-width: 990px) {
    .sb__stage { width: 100%; max-width: 56rem; margin-inline: 0; }
  }

  /* Soft accent blob behind the picture */
  .sb__blob {
    position: absolute;
    inset: 12% 8% 8%;
    border-radius: 48% 52% 46% 54% / 55% 45% 55% 45%;
    background: color-mix(in srgb, var(--sb-accent) 14%, transparent);
    z-index: 0;
  }

  .sb__character { position: absolute; inset: 0; z-index: 1; }

  /* All layers are stacked on the same canvas. Stacking order: base < sponge < topping < frosting < extra */
  .sb__base,
  .sb__placeholder,
  .sb__layer,
  .sb__layer-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .sb__placeholder { padding: 20%; background: var(--sb-soft); fill: rgba(var(--color-foreground), 0.3); }
  .sb__base { z-index: 1; }
  .sb__layer { pointer-events: none; }
  .sb__layer[data-layer="sponge"]    { z-index: 2; }
  .sb__layer[data-layer="topping"] { z-index: 3; }
  .sb__layer[data-layer="frosting"]       { z-index: 4; }
  .sb__layer[data-layer="extra"]    { z-index: 5; }

  /* Layer swap: inactive layers are invisible + slightly offset; `.is-active` pops them in.
     Using a transition (not an animation) means swaps also animate smoothly when removed. */
  .sb__layer-img {
    opacity: 0;
    transform: translateY(1rem) scale(0.94);
    transform-origin: 50% 70%;
    transition: opacity 0.25s ease, transform 0.5s var(--sb-ease-pop);
  }
  .sb__layer-img.is-active { opacity: 1; transform: none; }

  /* Extras get an extra little hop when they arrive */
  .sb__layer[data-layer="extra"] .sb__layer-img.is-active { animation: sb-hop 0.6s ease-out; }

  /* Completed look: picture wiggles once + sparks fly out (JS toggles `.is-celebrating`) */
  .sb__stage.is-celebrating .sb__character { animation: sb-wiggle 0.8s ease-in-out; }
  .sb__sparks { position: absolute; inset: 0; z-index: 6; pointer-events: none; }
  .sb__spark {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 1rem;
    height: 1rem;
    margin: -0.5rem 0 0 -0.5rem;
    border-radius: 50%;
    background: var(--sb-accent);
    opacity: 0;
  }
  .sb__spark:nth-child(even) { width: 0.7rem; height: 0.7rem; background: rgb(var(--color-foreground)); }
  .sb__stage.is-celebrating .sb__spark {
    animation: sb-spark 0.9s ease-out forwards;
    animation-delay: calc(var(--i) * 25ms);
  }

  @keyframes sb-hop {
    0%   { transform: translateY(1rem) scale(0.94); }
    55%  { transform: translateY(-1.6rem) scale(1.02); }
    100% { transform: none; }
  }
  @keyframes sb-wiggle {
    0%, 100% { transform: none; }
    25% { transform: rotate(-2deg) scale(1.02); }
    50% { transform: rotate(2deg) scale(1.03); }
    75% { transform: rotate(-1deg) scale(1.01); }
  }
  @keyframes sb-spark {
    from { opacity: 1; transform: rotate(var(--a)) translateY(0) scale(1); }
    to   { opacity: 0; transform: rotate(var(--a)) translateY(-18rem) scale(0.3); }
  }

  /* ---- Tabs ---- */
  .sb__tabs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.6rem;
    padding: 0.4rem;
    border-radius: 999px;
    background: var(--sb-soft);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sb__tabs::-webkit-scrollbar { display: none; }
  .sb__tab {
    flex: 1 0 auto;
    min-height: 4.4rem;
    padding: 0 2rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .sb__tab:hover { background: rgba(var(--color-foreground), 0.08); }
  .sb__tab[aria-selected="true"] { background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); }

  /* ---- Option cards ---- */
  .sb__options {
    display: flex;               /* mobile: one horizontally scrollable row */
    gap: 1rem;
    margin: 0;
    padding: 0.6rem 0.4rem 1.4rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 0.4rem;
    -webkit-overflow-scrolling: touch;
  }
  .sb__option { flex: 0 0 12rem; scroll-snap-align: start; }

  @media screen and (min-width: 750px) {
    .sb__options {               /* desktop/tablet: wrapping grid, no scrolling */
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
      overflow: visible;
      padding-bottom: 0.6rem;
    }
    .sb__option { flex: none; }
  }

  .sb__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    width: 100%;
    padding: 0.8rem 0.8rem 1.2rem;
    border: 0.1rem solid var(--sb-line);
    border-radius: var(--sb-radius);
    background: rgb(var(--color-background));
    color: inherit;
    font: inherit;
    text-align: center;
    cursor: pointer;
    transition: transform 0.25s var(--sb-ease-pop), border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .sb__card:hover { transform: translateY(-0.3rem); border-color: rgba(var(--color-foreground), 0.35); }
  .sb__card:active { transform: scale(0.97); }
  .sb__card[aria-pressed="true"] {
    border-color: var(--sb-accent);
    box-shadow: 0 0 0 0.2rem var(--sb-accent);
  }
  .sb__card-label { font-size: 1.4rem; font-weight: 600; line-height: 1.3; }

  /* Thumbnail = cropped "window" onto the full-canvas layer image.
     --zoom: magnification, --fx / --fy: focus point (0–1) of the canvas.
     Tune these per category if your artwork is positioned differently. */
  .sb__card[data-category="sponge"]    { --zoom: 1.6; --fx: 0.5; --fy: 0.68; }
  .sb__card[data-category="frosting"]       { --zoom: 1.7; --fx: 0.5; --fy: 0.45; }
  .sb__card[data-category="topping"] { --zoom: 2.0; --fx: 0.5; --fy: 0.33; }
  .sb__card[data-category="extra"]    { --zoom: 1.7; --fx: 0.5; --fy: 0.28; }

  .sb__thumb {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: calc(var(--sb-radius) - 0.8rem);
    background: var(--sb-soft);
  }
  .sb__thumb-img {
    position: absolute;
    max-width: none;
    width: calc(var(--zoom) * 100%);
    height: auto;
    left: calc(50% - var(--fx) * var(--zoom) * 100%);
    top: calc(50% - var(--fy) * var(--zoom) * 100% / var(--sb-ratio));
  }

  .sb__check {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--sb-accent);
    color: var(--sb-on-accent);
    transform: scale(0);
    transition: transform 0.3s var(--sb-ease-pop);
  }
  .sb__card[aria-pressed="true"] .sb__check { transform: scale(1); }

  /* ---- Buttons (Surprise me / Shop the look) ---- */
  .sb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 4.8rem;
    padding: 0 2.6rem;
    border: 0.1rem solid transparent;
    border-radius: 999px;
    font: inherit;
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s var(--sb-ease-pop), opacity 0.2s ease, background-color 0.2s ease;
  }
  .sb__btn:hover { transform: translateY(-0.2rem); }
  .sb__btn:active { transform: scale(0.97); }
  .sb__btn--primary { background: var(--sb-accent); color: var(--sb-on-accent); }
  .sb__btn--ghost { background: transparent; color: inherit; border-color: rgba(var(--color-foreground), 0.35); }
  .sb__btn--ghost:hover { background: var(--sb-soft); }
  .sb__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sb-actions-gap, 20px);
    margin-top: 1.2rem;
  }
  .sb__dice,
  .sb__reset-icon { transition: transform 0.5s var(--sb-ease-pop); }
  .sb__surprise:hover .sb__dice,
  .sb__surprise:active .sb__dice { transform: rotate(180deg); }
  .sb__reset:hover .sb__reset-icon,
  .sb__reset:active .sb__reset-icon { transform: rotate(-180deg); }

  /* Shop the Look disabled state (no href until something is selected) */
  .sb__cta[aria-disabled="true"] { opacity: 0.4; cursor: not-allowed; pointer-events: none; }

  /* ---- Summary ---- */
  .sb__summary {
    padding: 2rem;
    border: 0.1rem solid var(--sb-line);
    border-radius: calc(var(--sb-radius) + 0.4rem);
  }
  .sb__summary-title {
    margin: 0 0 1.2rem;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: 2rem;
  }
  .sb__total { display: flex; justify-content: space-between; align-items: baseline; margin: 0 0 1.6rem; padding-top: 1.2rem; border-top: 0.1rem solid var(--sb-line); font-size: 1.6rem; }
  .sb__total[hidden] { display: none; }
  .sb__total strong { font-size: 2rem; }
  .sb__empty { margin: 0 0 1.6rem; font-size: 1.5rem; opacity: 0.7; }
  .sb__picks { display: grid; gap: 0.8rem; margin: 0 0 1.6rem; padding: 0; list-style: none; }
  .sb__picks:not(:has(.sb__pick:not([hidden]))) { display: none; margin: 0; }
  .sb__pick[hidden] { display: none; }
  .sb__pick-link {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0.8rem;
    border-radius: 1.4rem;
    background: var(--sb-soft);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .sb__pick-link:hover { background: rgba(var(--color-foreground), 0.08); }
  .sb__pick:not([hidden]) { animation: sb-pick-in 0.35s var(--sb-ease-pop); }
  @keyframes sb-pick-in { from { opacity: 0; transform: translateY(0.8rem) scale(0.97); } to { opacity: 1; transform: none; } }
  .sb__pick-img { flex: none; width: 5.6rem; height: 5.6rem; border-radius: 1rem; object-fit: cover; }
  .sb__pick-text { display: flex; flex-direction: column; min-width: 0; font-size: 1.4rem; line-height: 1.35; }
  .sb__pick-cat { font-size: 1.2rem; opacity: 0.65; }
  .sb__pick-name { font-weight: 600; }

  /* ---- Accessibility ---- */
  .sb__sr {
    position: absolute !important;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  /* Visible keyboard focus for every interactive control */
  .sb__tab:focus-visible,
  .sb__card:focus-visible,
  .sb__btn:focus-visible,
  .sb__pick-link:focus-visible {
    outline: 0.3rem solid rgb(var(--color-foreground));
    outline-offset: 0.3rem;
  }

  /* Respect users who prefer less motion: keep state changes, drop movement */
  @media (prefers-reduced-motion: reduce) {
    .sb *, .sb *::before, .sb *::after {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }
    .sb__layer-img { transform: none; }
  }
{% endstylesheet %}

{% javascript %}
  /* =========================================================================
     <sweets-builder> custom element.
     - One instance per section, so several copies of the section never clash.
     - All lookups use `this.querySelector…`, never `document`.
     - State = one selected block id per category: { sponge: 'block-id', … }
     - Markup is pre-rendered by Liquid; JS only toggles classes/attributes.
     ========================================================================= */
  (() => {
    if (customElements.get('sweets-builder')) return;

    class SweetsBuilder extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return; // guard against double init on re-attach
        this.initialized = true;

        this.stage = this.querySelector('[data-stage]');
        this.live = this.querySelector('[data-live]');
        this.cta = this.querySelector('[data-cta]');
        this.empty = this.querySelector('[data-empty]');
        this.tabs = Array.from(this.querySelectorAll('[role="tab"]'));
        this.panels = Array.from(this.querySelectorAll('[role="tabpanel"]'));
        this.categories = this.tabs.map((tab) => tab.dataset.category);
        this.baseLabel = this.stage.dataset.baseLabel || '';
        this.selection = {}; // { category: blockId }
        this.wasComplete = false;

        // One delegated click listener for tabs, cards, "Surprise me" and reset
        this.addEventListener('click', (event) => {
          const card = event.target.closest('[data-option]');
          if (card) return this.toggle(card.dataset.category, card.dataset.blockId);

          const tab = event.target.closest('[role="tab"]');
          if (tab) return this.activateTab(tab);

          if (event.target.closest('[data-surprise]')) this.surprise();
          if (event.target.closest('[data-reset]')) this.reset();
        });

        // Roving-tabindex keyboard support for the tablist (arrows / Home / End)
        this.querySelector('[role="tablist"]').addEventListener('keydown', (event) => {
          const keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End'];
          if (!keys.includes(event.key)) return;
          event.preventDefault();
          const last = this.tabs.length - 1;
          let index = this.tabs.indexOf(document.activeElement);
          if (event.key === 'ArrowRight') index = index === last ? 0 : index + 1;
          if (event.key === 'ArrowLeft') index = index === 0 ? last : index - 1;
          if (event.key === 'Home') index = 0;
          if (event.key === 'End') index = last;
          this.activateTab(this.tabs[index], true);
        });

        // Theme Editor: selecting a block in the sidebar previews that option
        this.addEventListener('shopify:block:select', (event) => {
          const card = event.target.matches('[data-option]') ? event.target : event.target.querySelector('[data-option]');
          if (!card) return;
          const tab = this.tabs.find((t) => t.dataset.category === card.dataset.category);
          if (tab) this.activateTab(tab);
          this.apply(card.dataset.category, card.dataset.blockId);
          this.refresh();
        });

        this.refresh();
      }

      disconnectedCallback() {
        clearTimeout(this.celebrateTimer);
      }

      /* ---- Tabs: show one panel at a time ---- */
      activateTab(tab, moveFocus = false) {
        this.tabs.forEach((t) => {
          const isActive = t === tab;
          t.setAttribute('aria-selected', String(isActive));
          t.tabIndex = isActive ? 0 : -1;
        });
        this.panels.forEach((panel) => {
          panel.hidden = panel.id !== tab.getAttribute('aria-controls');
        });
        if (moveFocus) tab.focus();
      }

      /* ---- Selection ---- */
      // Clicking the selected card again removes that layer.
      toggle(category, blockId) {
        this.apply(category, this.selection[category] === blockId ? null : blockId);
        this.refresh();
      }

      // Update state + the layer images + the cards of ONE category (no summary here).
      apply(category, blockId) {
        if (blockId) this.selection[category] = blockId;
        else delete this.selection[category];

        this.querySelectorAll(`[data-layer="${category}"] [data-layer-block]`).forEach((img) => {
          img.classList.toggle('is-active', img.dataset.layerBlock === blockId);
        });
        this.querySelectorAll(`[data-option][data-category="${category}"]`).forEach((card) => {
          card.setAttribute('aria-pressed', String(card.dataset.blockId === blockId));
        });
      }

      /* ---- Surprise me: one random option per category ---- */
      surprise() {
        this.categories.forEach((category) => {
          const options = Array.from(this.querySelectorAll(`[data-option][data-category="${category}"]`));
          if (!options.length) return;
          // Avoid re-picking the current option when there is an alternative
          const pool = options.length > 1 ? options.filter((o) => o.dataset.blockId !== this.selection[category]) : options;
          this.apply(category, pool[Math.floor(Math.random() * pool.length)].dataset.blockId);
        });
        this.refresh(true);
      }

      /* ---- Reset: clear every category so the look can be rebuilt ---- */
      reset() {
        this.categories.forEach((category) => this.apply(category, null));
        this.wasComplete = false;
        this.stage.classList.remove('is-complete', 'is-celebrating');
        this.refresh();
      }

      /* ---- Everything that depends on the whole selection ---- */
      refresh(forceCelebrate = false) {
        const ids = this.categories.map((c) => this.selection[c]).filter(Boolean);

        // 1. Show / hide product rows
        this.querySelectorAll('[data-pick-block]').forEach((row) => {
          row.hidden = !ids.includes(row.dataset.pickBlock);
        });
        if (this.empty) this.empty.hidden = ids.length > 0;

        // 1b. Running total (prices are in minor units, e.g. cents)
        const totalBox = this.querySelector('[data-total]');
        if (totalBox) {
          const cents = ids.reduce((sum, id) => {
            const row = this.querySelector(`[data-pick-block="${CSS.escape(id)}"]`);
            return sum + (row ? Number(row.dataset.price) || 0 : 0);
          }, 0);
          totalBox.hidden = ids.length === 0;
          try {
            totalBox.querySelector('[data-total-value]').textContent = new Intl.NumberFormat(
              document.documentElement.lang || undefined,
              { style: 'currency', currency: this.dataset.currency || 'USD' }
            ).format(cents / 100);
          } catch (e) { /* unknown currency code: leave empty */ }
        }

        // 2. Shop the Look → first selected product's page.
        //    TODO (later): replace with add-to-cart of all selected products, e.g. POST /cart/add.js
        if (this.cta) {
          const firstLink = ids
            .map((id) => this.querySelector(`[data-pick-block="${CSS.escape(id)}"] a`))
            .find(Boolean);
          if (firstLink) {
            this.cta.href = firstLink.href;
            this.cta.removeAttribute('aria-disabled');
          } else if (this.cta.dataset.fallbackHref) {
            this.cta.href = this.cta.dataset.fallbackHref;
            this.cta.removeAttribute('aria-disabled');
          } else {
            this.cta.removeAttribute('href');
            this.cta.setAttribute('aria-disabled', 'true');
          }
        }

        // 3. Accessible description of the look ("Sponge: Safari set, Frosting: …")
        const parts = this.categories
          .filter((c) => this.selection[c])
          .map((c) => {
            const tab = this.tabs.find((t) => t.dataset.category === c);
            const card = this.querySelector(`[data-option][data-block-id="${CSS.escape(this.selection[c])}"]`);
            return `${tab.textContent.trim()}: ${card ? card.dataset.label : ''}`;
          });
        this.stage.setAttribute('aria-label', [this.baseLabel, ...parts].filter(Boolean).join(', '));
        if (this.live) this.live.textContent = parts.join('. ');

        // 4. Completed look = every available category has a selection
        const complete = this.categories.every((c) => this.selection[c]);
        this.stage.classList.toggle('is-complete', complete);
        if (complete && (!this.wasComplete || forceCelebrate)) this.celebrate();
        this.wasComplete = complete;
      }

      /* ---- Celebration: restart the CSS animation, then clean up ---- */
      celebrate() {
        this.stage.classList.remove('is-celebrating');
        void this.stage.offsetWidth; // force reflow so the animation can restart
        this.stage.classList.add('is-celebrating');
        clearTimeout(this.celebrateTimer);
        this.celebrateTimer = setTimeout(() => this.stage.classList.remove('is-celebrating'), 1300);
      }
    }

    customElements.define('sweets-builder', SweetsBuilder);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Sweets builder",
  "tag": "section",
  "class": "section",
  "max_blocks": 48,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your dream cupcake"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pick a sponge, frosting, topping and a little extra, then shop the treats."
    },
    {
      "type": "header",
      "content": "Plate"
    },
    {
      "type": "image_picker",
      "id": "base_image",
      "label": "Plate or stand image (optional)",
      "info": "Transparent PNG. All layer images must use the same canvas size (for example 900 x 1200 px)."
    },
    {
      "type": "text",
      "id": "base_alt",
      "label": "Description (alt text)",
      "info": "Read by screen readers together with the current selection.",
      "default": "A cupcake on a plate"
    },
    {
      "type": "header",
      "content": "Category names"
    },
    { "type": "text", "id": "tab_sponge", "label": "Sponges tab", "default": "Sponge" },
    { "type": "text", "id": "tab_frosting", "label": "Frostings tab", "default": "Frosting" },
    { "type": "text", "id": "tab_topping", "label": "Toppings tab", "default": "Topping" },
    { "type": "text", "id": "tab_extra", "label": "Extras tab", "default": "Extra" },
    {
      "type": "header",
      "content": "Buttons and messages"
    },
    {
      "type": "text",
      "id": "surprise_label",
      "label": "Surprise button label",
      "default": "Surprise me"
    },
    {
      "type": "text",
      "id": "reset_label",
      "label": "Reset button label",
      "default": "Start over"
    },
    {
      "type": "range",
      "id": "actions_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between action buttons",
      "default": 20
    },
    {
      "type": "text",
      "id": "summary_heading",
      "label": "Selected products heading",
      "default": "Your creation"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label (leave empty to hide the total)",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty selection message",
      "default": "Pick a sponge to start building your cupcake."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Shop the look button label",
      "default": "Shop the look"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Shop the look fallback link",
      "info": "Optional. Used while nothing is selected, e.g. a collection page."
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "sponge",
      "name": "Sponge",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "image_picker", "id": "layer_image", "label": "Layer image", "info": "Transparent PNG, same canvas size as the base image." },
        { "type": "product", "id": "product", "label": "Related product" }
      ]
    },
    {
      "type": "frosting",
      "name": "Frosting",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "image_picker", "id": "layer_image", "label": "Layer image", "info": "Transparent PNG, same canvas size as the base image." },
        { "type": "product", "id": "product", "label": "Related product" }
      ]
    },
    {
      "type": "topping",
      "name": "Topping",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "image_picker", "id": "layer_image", "label": "Layer image", "info": "Transparent PNG, same canvas size as the base image." },
        { "type": "product", "id": "product", "label": "Related product" }
      ]
    },
    {
      "type": "extra",
      "name": "Extra",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "image_picker", "id": "layer_image", "label": "Layer image", "info": "Transparent PNG, same canvas size as the base image." },
        { "type": "product", "id": "product", "label": "Related product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sweets builder"
    }
  ]
}
{% endschema %}
