{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background-color: {{ section.settings.background_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .features-center {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .features-center__header {
    text-align: center;
    position: relative;
    max-width: 800px;
    margin: 0 auto 3rem;
  }

  .features-center__subheading.rte {
    margin: 0 0 0.5rem;
  }

  .features-center__subheading.rte p {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 1.3rem;
    font-weight: 500;
    color: {{ section.settings.subcaption_color }};
    font-family: 'Open Sans', sans-serif;
  }

  .features-center__title-wrapper {
    position: relative;
    display: inline-block;
  }

  .features-center__heading {
    position: relative;
    z-index: 2;
    margin: 0 0 1rem;
   font-family: var(--font-heading-family), serif; 
    letter-spacing: 0.05em;
    color: {{ section.settings.heading_color }};
    text-transform: uppercase;
  }

  .features-center__description {
    color: {{ section.settings.text_color }};
    font-size: 1.8rem;
    margin: 0;
    line-height: 1.5;
    font-family: 'Montserrat', sans-serif;
  }

 
  .features-center__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .features-center__grid {
      grid-template-columns: 1fr 1.2fr 1fr;
      gap: 2rem;
    }
  }

 
  .features-center__image-col {
    display: flex;
    justify-content: center;
    order: 0; 
    margin: 1rem 0;
  }

  .features-center__column--left {
    order: -1; 
  }

  .features-center__column--right {
    order: 1; 
  }

  .features-center__image-wrapper {
    width: 100%;
    max-width: 555px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }

  .features-center__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .features-center__placeholder {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
  }

  /* Side Columns & Items */
  .features-center__column {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .features-center__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    .features-center__column {
      gap: 3rem;
    }

    .features-center__column--left .features-center__item {
      align-items: flex-end;
      text-align: right;
    }

    .features-center__column--right .features-center__item {
      align-items: flex-start;
      text-align: left;
    }
  }

  .features-center__icon {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background-color: {{ section.settings.icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }

  .features-center__icon svg,
  .features-center__icon img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .features-center__item-heading {
  font-family: var(--font-heading-family), serif; 
    font-size: 2.8rem;
    margin: 0 0 0.5rem;
    color: {{ section.settings.heading_color }};
    font-weight: 400;
  }

  .features-center__item-text {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 1.6rem;
    line-height: 1.6;
    max-width: 320px;
    font-family: 'Open Sans', sans-serif;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}">
  <div class="features-center">
    
    {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.description != blank -%}
      <div class="features-center__header">
        {%- if section.settings.subheading != blank -%}
          <div class="features-center__subheading rte">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <div class="features-center__title-wrapper">
            <h2 class="features-center__heading {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
          </div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="features-center__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="features-center__grid">
  
      <div class="features-center__column features-center__column--left">
        {%- for block in section.blocks -%}
          {%- assign mod = forloop.index | modulo: 2 -%}
          {%- if mod != 0 -%}
            <div class="features-center__item" {{ block.shopify_attributes }}>
              <div class="features-center__icon">
                {%- if block.settings.custom_icon != blank -%}
                  {{ block.settings.custom_icon | image_url: width: 64 | image_tag: loading: 'lazy' }}
                {%- else -%}
                  {% render 'icon-feature-placeholder', icon: block.settings.icon %}
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="features-center__item-heading">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="features-center__item-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="features-center__image-col">
        <div class="features-center__image-wrapper">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                class: 'features-center__image',
                widths: '375, 550, 750, 1000',
                alt: section.settings.image.alt | escape
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'features-center__placeholder' }}
          {%- endif -%}
        </div>
      </div>
      <div class="features-center__column features-center__column--right">
        {%- for block in section.blocks -%}
          {%- assign mod = forloop.index | modulo: 2 -%}
          {%- if mod == 0 -%}
            <div class="features-center__item" {{ block.shopify_attributes }}>
              <div class="features-center__icon">
                {%- if block.settings.custom_icon != blank -%}
                  {{ block.settings.custom_icon | image_url: width: 64 | image_tag: loading: 'lazy' }}
                {%- else -%}
                  {% render 'icon-feature-placeholder', icon: block.settings.icon %}
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="features-center__item-heading">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="features-center__item-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Features Center Image",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header Settings"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>FEATURES</p>"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WHAT MAKES US DIFFERENT"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Discover the key qualities that make our desserts special and your experience enjoyable."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Center Circular Image"
    },
    {
      "type": "header",
      "content": "Layout & Sizing"
    },
    {
      "type": "range",
      "id": "page_width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "default": 1200,
      "unit": "px",
      "label": "Maximum Width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "subcaption_color",
      "label": "Subheading Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2B2B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#777777"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon Background Color",
      "default": "#F8C5C5"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (PNG/SVG)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback System Icon",
          "default": "bake",
          "options": [
            { "value": "bake", "label": "Baking / Mixer" },
            { "value": "design", "label": "Piping Bag / Design" },
            { "value": "pie", "label": "Pie / Cake" },
            { "value": "delivery", "label": "Delivery / Service" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Feature description text goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features Center Image",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Fresh Daily Baking",
            "text": "Every dessert is prepared fresh using selected ingredients."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Premium Ingredients",
            "text": "We use high-quality ingredients to ensure rich taste."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Custom Cake Design",
            "text": "Personalized cakes created to match your style."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Reliable Service",
            "text": "Smooth ordering process with timely preparation and delivery."
          }
        }
      ]
    }
  ]
}
{% endschema %}